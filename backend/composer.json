{
    "name": "flyka/campaign-management",
    "description": "Campaign management system for a Cairn-homebrew TRPG (DM and players, LAN-only).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/twig-view": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Flyka\\CampaignManagement\\": "src/"
        },
        "files": [
            "src/Http/functions.php"
        ]
    },
    "require-dev": {
        "rector/rector": "^2.7",
        "symplify/easy-coding-standard": "^13.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Flyka\\CampaignManagement\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.33"
        }
    },
    "scripts": {
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "qa": [
            "@ecs",
            "@rector",
            "@stan",
            "@test"
        ]
    }
}
