{% extends 'layout.twig' %}
{% block title %}Items — Regelwerk{% endblock %}
{% block content %}
    <h1>Items</h1>

    <table class="ref-table">
        <thead>
            <tr><th>Name</th><th>Kategorie</th><th>Kosten</th><th>Supply</th><th>Effekt</th></tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.name }}</td>
                    <td>{{ item.category }}</td>
                    <td>{{ item.cost ?: '—' }}</td>
                    <td>{{ item.supply ?: '—' }}</td>
                    <td>{{ item.effect ?: '—' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
