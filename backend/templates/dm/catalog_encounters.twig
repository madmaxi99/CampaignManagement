{% extends "layout_dm.twig" %}
{% import "_ui.twig" as ui %}
{% import "dm/_tables.twig" as t %}

{% block title %}Katalog: Begegnungen{% endblock %}

{% block main_class %} dm-main--fill{% endblock %}

{% block content %}
    <div class="catalog-workspace catalog-workspace--two">
        <div class="catalog-browser catalog-browser--nav ui-card">
            {% include 'dm/_catalog_nav.twig' with {section: 'encounters'} %}
        </div>

        <section class="catalog-editor ui-stack">
            <p class="ui-muted">Die Zufallsbegegnungen sind festes Regelwerk und hier nur zum Nachschlagen. Orte in der Kampagne wählen eine Tabelle aus.</p>
            {% for table in encounterTables %}{{ t.encounter(table, true) }}{% endfor %}
        </section>
    </div>
{% endblock %}
