{# Fragment: one DM rules chapter, loaded into the lookup reader. #}
{% import "_ui.twig" as ui %}
{% import "rules/_macros.twig" as r %}
<article class="lore-chapter ui-card ui-stack">
    <h2>{{ chapter.title }}</h2>
    {% if chapter.slug == 'spielleitung' %}
    {{ r.dm('Die Rolle der Spielleitung', 'Tipps', '<p>Als SL beschreibst du, was die Charaktere sehen, wem sie begegnen und welche Herausforderungen warten. Wie die Regie eines Films setzt du die Szene und trägst viel zu einer guten Geschichte bei. Die Rolle kann auch unter allen Mitgliedern der Gruppe wechseln.</p><p><strong>Alle einbinden:</strong> Achte darauf, dass sich alle einbezogen fühlen. Bekommt eine Figur viel Aufmerksamkeit, gib den anderen auch Rampenlicht. Achte aufs Tempo: Streue ruhigere Szenen zwischen intensive Ereignisse. Wird das Spiel zäh und die Spielenden langweilen sich, lass etwas Aufregendes geschehen, das sie zum Reagieren zwingt.</p><p><strong>Offen würfeln:</strong> Die SL würfelt oft für NSC und Monster. Es ist verlockend, heimlich zu würfeln, um das Drama zu steuern, aber wir empfehlen, immer offen zu würfeln. Das bindet alle ein und erhöht die Spannung am Tisch.</p><p><strong>Mit den Spielenden spielen:</strong> Du kontrollierst alle Gegner und Gefahren, aber ihr spielt zusammen, nicht gegeneinander. Setzen die Spielenden einen cleveren Plan erfolgreich um, lass sie sich gut fühlen und freu dich, gemeinsam Geschichten und bleibende Erinnerungen zu erschaffen.</p><p><strong>Die Welt zum Leben erwecken:</strong> Male ein Bild einer echten Welt mit Details, Geräuschen und Gerüchen: die Eulen im nächtlichen Lager, die Frösche im Sumpf, das Rascheln der Blätter im Wind. Ein oder zwei Details reichen oft, damit eine Szene oder ein Ort lebendig wird.</p>') }}
    {{ r.dm('NSC verwalten', 'NSC', '<p>Mechanisch funktionieren NSC wie Spielercharaktere: Sie bewegen sich, führen Aktionen aus, erleiden Schaden und nutzen WP. In der Praxis solltest du alle Regeln für NSC ignorieren, die keinen Spielercharakter direkt betreffen. Würfle nicht für Aktionen von NSC, es sei denn, sie greifen einen Spielercharakter an oder heilen ihn. Du <em>kannst</em> in anderen Situationen würfeln, wenn es das Drama verstärkt. Gegen eine nicht aufgeführte Fertigkeit würfelt der NSC auf den Standardwert 5.</p>') }}
    {{ r.dm('Gefolge & Bosse', 'NSC', '<p>NSC lassen sich in zwei Gruppen teilen:</p><p><strong>Gefolge</strong> sind Gruppen weniger bedeutender NSC mit identischen Werten. Sie haben selten Namen oder Persönlichkeit. Ein Gefolgsmitglied mit null TP ist tot, außer die SL möchte, dass es überlebt, etwa um den Charakteren mit letzten Worten etwas Wichtiges zu sagen. Gefolge nutzt fast nie WP und handelt oft im selben Zug.</p><p><strong>Bosse</strong> sind anders: Sie haben oft Namen und Hintergrund und spielen meist eine wichtige Rolle im Abenteuer. Ein Boss zieht eine eigene Initiativkarte, hat WP und nutzt angeborene und Heldenfähigkeiten wie Spielercharaktere. Besonders mächtige Bosse haben oft mehrere Heldenfähigkeiten, nicht zuletzt Robust und Fokussiert mehrfach, was ihnen weit mehr TP und WP als den Spielercharakteren gibt. Lass Bosse nach Möglichkeit nicht zu früh sterben: Ein Boss, der überlebt, um ein andermal zu kämpfen, macht mehr Spaß als ein toter. Sorge auch dafür, dass die Charaktere nicht zu leicht an den Boss herankommen, etwa durch Gefolge, das zuerst erledigt werden muss. Ein Bosskampf sollte herausfordernd sein.</p>') }}
    {{ r.dm('NSC und Fertigkeiten', 'Regel', '<p>NSC nutzen Fertigkeiten wie Spielercharaktere. Die SL würfelt für sie, aber nur für Aktionen, die einen Spielercharakter unmittelbar betreffen, etwa wenn der NSC einen Spielercharakter angreift oder heilt. Bei Aktionen ohne direkten Einfluss entscheidet die SL einfach, was passiert. In den Werten der NSC stehen nicht alle Fertigkeiten: Würfelt die SL gegen eine nicht aufgeführte Fertigkeit, gilt der Standardwert <strong>5</strong>.</p>') }}
    {{ r.dm('Attribute für NSC', 'NSC', '<p>In Abenteuern stehen für NSC keine Attributswerte, weil sie sehr selten gebraucht werden. Musst du doch einmal gegen einen genauen Attributswert würfeln, nutze diese Richtlinien:</p><ul><li><strong>STÄ &amp; GEW:</strong> Nimm den Schadensbonus. Bei +W6 würfelst du gegen einen Wert von 17, bei +W4 gegen 14, ohne Bonus gegen 10.</li><li><strong>KON:</strong> Würfle gegen die maximalen TP, verringert um 2 je Stufe der Heldenfähigkeit Robust.</li><li><strong>WIL:</strong> Würfle gegen die maximalen WP, falls angegeben, verringert um 2 je Stufe der Heldenfähigkeit Fokussiert. Sind keine WP angegeben, würfle gegen 10.</li><li><strong>INT &amp; CHA:</strong> Würfle gegen 10.</li></ul>') }}
    {{ r.dm('Typische NSC', 'Bestiarium', '<p>Werte für typische NSC (Wache, Kultist, Dieb, Dorfbewohner, Jäger, Bandit, Abenteurer, Gelehrter sowie die Bosse Banditenanführer, Ritter-Champion und Erzmagier) stehen im Bestiarium des DM-Bereichs in der Kategorie Alltagsvolk.</p>') }}
    {{ r.dm('NSC erschaffen', 'Tabellen', '<p>Mit den Tabellen weiter unten, NSC erschaffen, entsteht schnell ein einzigartiger NSC: Am Tisch würfelst du je einen Würfel jeder Art (W4 Haltung, W6 Volk, W8 Motivation, W10 Beruf, W12 Eigenart, W20 Name, bei dem du einen der drei Namen wählst).</p>') }}
    {% elseif chapter.slug == 'kampf' %}
    {{ r.dm('NSC-Initiative', 'Initiative', '<p>Um große Kämpfe zu vereinfachen, kann die Spielleitung eine einzige Karte für eine ganze NSC-Gruppe ziehen. Alle handeln dann im selben Zug, die Reihenfolge untereinander legt die Spielleitung fest. Monster haben oft mehrere Züge pro Runde und ziehen entsprechend mehrere Karten. Bei Überraschung wählt die Spielleitung, ob ein Angriff als überraschend gilt.</p>') }}
    {{ r.dm('NSC bei besonderen Angriffen', 'Vergleichend', '<p>Würfelt die Spielleitung für einen NSC, der die betreffende Fertigkeit nicht hat, würfelt sie gegen den Standardwert 5.</p>') }}
    {{ r.dm('NSC bei null TP', 'Tod', '<p>Erreicht ein NSC null TP, gibt es keine Todeswürfe. Die Spielleitung entscheidet, ob er lebt oder stirbt. Ein sofort tötender Angriff tötet einen NSC jedoch ebenso wie einen Spielercharakter.</p>') }}
    {{ r.dm('Improvisierte Waffen bereitstellen', 'Umgebung', '<p>Zu Kampfbeginn kann die Spielleitung W3 improvisierte Waffen auswürfeln oder festlegen, ihre Position auf der Karte markieren oder sagen, dass sie überall in der Gegend verfügbar sind. Abenteuer können eigene improvisierte Waffen für einen Ort mitbringen.</p>') }}
    {% for t in tables.roll_tables['Improvisierte Waffen']|default([])|filter(t => t.code != 'jagd') %}{{ r.rolltable(t, true) }}{% endfor %}
    {% elseif chapter.slug == 'monster' %}
    {{ r.quick('Monster im Kampf', 'Bestiarium', '<p>Ein Monster ist ein Wesen unnatürlichen Ursprungs, eine schreckliche Bestie, die Angst und Schrecken verbreitet. Die Spielleitung steuert Monster im Kampf weitgehend wie Spielercharaktere und NSC, mit einigen wichtigen Unterschieden (siehe unten). Das Bestiarium im Spielleitungsbereich enthält Werte für Monster, humanoide Wesen und gewöhnliche Tiere.</p>') }}
    {{ r.quick('Grimmigkeit', 'Monster', '<p>Manche Monster sind so mächtig, dass sie mehrmals in derselben Runde handeln können. Das zeigt ihr Wert für <strong>Grimmigkeit</strong>. Zu Beginn jeder Runde zieht die Spielleitung für jeden Punkt Grimmigkeit eine Initiativekarte. Das Monster erhält pro Karte einen Zug mit je einer Aktion und einer Bewegung.</p><p><strong>Abwarten:</strong> Tauscht ein Spielercharakter die Initiativekarte mit einem Monster (optionale Regel), darf er sich eine beliebige Karte des Monsters aussuchen. Monster selbst warten nie.</p>') }}
    {{ r.quick('Größe', 'Monster', '<p>Die Größe bestimmt, wie viel Fläche ein Monster blockieren kann und durch wie enge Durchgänge es passt.</p><ul>
        <li><strong>Klein:</strong> weniger als einen Meter groß, blockiert keine Fläche und passt durch winzige Durchgänge.</li>
        <li><strong>Normal:</strong> etwa menschengroß, blockiert 2×2 Meter (ein Feld auf der Kampfkarte) und passt durch einen halben Meter breiten Durchgang.</li>
        <li><strong>Groß:</strong> blockiert 4×4 Meter und passt durch einen Meter breiten Durchgang.</li>
        <li><strong>Riesig:</strong> blockiert 8×8 Meter und passt durch einen zwei Meter breiten Durchgang.</li>
        <li><strong>Schwarm:</strong> von Normal bis Riesig, blockiert aber nie die Fläche, in der er sich befindet, und passt durch winzige Durchgänge.</li>
    </ul>') }}
    {{ r.quick('Monsterbewegung', 'Monster', '<p>Wie Spielercharaktere haben Monster eine Bewegungsrate und können sich vor oder nach ihrem Angriff bewegen oder ihre Bewegung davor und danach aufteilen. Bei Monstern gilt die Rate <em>pro Zug</em>, nicht pro Runde. Manche Monster haben unterschiedliche Raten an Land, im Wasser und in der Luft. Starten und Landen sind freie Aktionen.</p>') }}
    {{ r.quick('Monsterangriffe', 'Monster', '<p>Ein Monster greift immer mit einem <strong>Monsterangriff</strong> an. Jedes Monster hat eine eigene Tabelle mit Monsterangriffen. Die Spielleitung wählt in ihrem Zug einen Angriff aus der Tabelle oder bestimmt ihn am Tisch per Wurf. Monster würfeln nie, um ihr Ziel zu treffen: <strong>Monsterangriffe gelingen automatisch.</strong> Ein Monsterangriff zählt als Aktion. Die Reichweite entspricht, sofern nicht anders angegeben, einem Nahkampfangriff (2 Meter).</p><ul>
        <li><strong>Ausweichen &amp; Parieren:</strong> Monsterangriffe können in der Regel ausgewichen, aber nicht pariert werden. Das gilt auch für Angriffe mit Wirkungsbereich, nicht aber für Furchtangriffe. Ausnahmen stehen in der Beschreibung des Angriffs.</li>
        <li><strong>Zustände:</strong> Monsterangriffe können Spielercharakteren Zustände zufügen. Hat der Charakter den Zustand schon, muss der Spieler einen anderen wählen.</li>
        <li><strong>Wiederholte Angriffe:</strong> Ein Monster führt nie zweimal hintereinander denselben Angriff aus. Fällt derselbe Angriff zweimal in Folge, wird er zum nächsten Angriff der Tabelle (aus der 6 wird die 1).</li>
    </ul>') }}
    {{ r.dm('Gefährlichere Monster', 'Bestiarium', '<p>Die Monster des Bestiariums sind typische Exemplare. Die Spielleitung kann Monster gefährlicher oder harmloser machen, um sie der Kompetenz der Charaktere anzupassen. Am einfachsten erhöht oder senkt man dazu die Grimmigkeit, aber auch die TP lassen sich anpassen.</p>') }}
    {% elseif chapter.slug == 'reise' %}
    {{ r.quick('Zufallsbegegnungen', 'Reise', '<p>Auf Reisen können die Charaktere den seltsamsten Geschöpfen aus nah und fern begegnen, deshalb stehen Zufallsbegegnungen meist im Abenteuer. Einmal pro Tagesabschnitt oder wann immer die SL es für angemessen hält, kann sie auf einer Tabelle für Zufallsbegegnungen würfeln. Die Tabellen hängen vom Gebiet ab. Die SL kann auch eine passende Begegnung wählen oder erfinden. Manche Begegnungen finden sogar nachts oder im Lager statt.</p><p>Wird die Wildnisleben-Probe des Wegführers einer Gruppe fällig und misslingt, folgt ein Reise-Missgeschick (Tabelle weiter unten, Reise &amp; Wildnis).</p>') }}
    {{ r.dm('Den Abenteuerort verlassen', 'Tabelle', '<p>Einen gefährlichen Ort voller Feinde zu verlassen, um zu lagern oder eine Rast über einen Tagesabschnitt zu halten, kann riskant sein. Wenn die Charaktere den Ort für mindestens einen Tagesabschnitt verlassen, wird auf der Tabelle Den Abenteuerort verlassen gewürfelt (weiter unten, Reise &amp; Wildnis). Ergibt das Ergebnis offensichtlich keinen Sinn, wird es ignoriert.</p>') }}
    {% for t in tables.roll_tables['Reise & Wildnis']|default([])|filter(t => t.code != 'jagd') %}{{ r.rolltable(t, true) }}{% endfor %}
    {% elseif chapter.slug == 'nsc' %}
    {% for t in tables.roll_tables['NSC erschaffen']|default([])|filter(t => t.code != 'jagd') %}{{ r.rolltable(t, true) }}{% endfor %}
    {% endif %}
</article>
