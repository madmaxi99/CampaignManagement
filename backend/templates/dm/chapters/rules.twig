{# Fragment: one DM rules chapter, loaded into the lookup reader. #}
{% import "_ui.twig" as ui %}
{% import "rules/_macros.twig" as r %}
<article class="lore-chapter ui-card ui-stack">
    <h2>{{ chapter.title }}</h2>
    {% if chapter.slug == 'spielleitung' %}
    {{ r.section('dm_spielleitung') }}
    {% elseif chapter.slug == 'kampf' %}
    {{ r.section('dm_kampf') }}
    {% for t in tables.roll_tables['Improvisierte Waffen']|default([])|filter(t => t.code != 'jagd') %}{{ r.rolltable(t, true) }}{% endfor %}
    {% elseif chapter.slug == 'monster' %}
    {{ r.section('dm_monster') }}
    {% elseif chapter.slug == 'reise' %}
    {{ r.section('dm_reise') }}
    {% for t in tables.roll_tables['Reise & Wildnis']|default([])|filter(t => t.code != 'jagd') %}{{ r.rolltable(t, true) }}{% endfor %}
    {% elseif chapter.slug == 'nsc' %}
    {% for t in tables.roll_tables['NSC erschaffen']|default([])|filter(t => t.code != 'jagd') %}{{ r.rolltable(t, true) }}{% endfor %}
    {% elseif chapter.slug == 'schaetze' %}
    {% for t in tables.roll_tables['Schätze']|default([]) %}{{ r.rolltable(t, true) }}{% endfor %}
    {% endif %}
</article>
