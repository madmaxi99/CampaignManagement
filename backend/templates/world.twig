{% extends "layout.twig" %}

{% block title %}Katalog{% endblock %}

{% block content %}
<div class="characters-page world-page">
    <h1>Katalog</h1>

    <h2 id="bestiary">Bestiary</h2>
    <ul>
        {% for b in bestiary %}
            <li>{{ b.name_de }} ({{ b.category_de }}, {{ b.hp }} TP)</li>
        {% endfor %}
    </ul>

    <h2 id="begegnungen">Zufallsbegegnungen</h2>
    {% for table in encounterTables %}
        <article>
            <h3>{{ table.name_de }}</h3>
            <ul>
                {% for e in table.entries %}
                    <li>{{ e.max_roll is null ? e.min_roll ~ '+' : (e.min_roll == e.max_roll ? e.min_roll : e.min_roll ~ '–' ~ e.max_roll) }}:
                        {{ [e.creature_de ? (e.quantity_de ? e.quantity_de ~ ' × ' ~ e.creature_de : e.creature_de), e.text_de]|filter(v => v)|join(' – ') }}</li>
                {% endfor %}
            </ul>
        </article>
    {% endfor %}
</div>
{% endblock %}
