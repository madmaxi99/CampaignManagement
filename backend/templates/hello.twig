<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>TRPG Management System — Hello World</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="page">
        <h1>Hallo, Abenteurer</h1>
        <p class="subtitle">Stack-Smoketest: Slim + Twig + SQLite</p>

        <p class="dm-entry"><a href="/dm" class="dm-button">DungeonMaster</a></p>

        <form action="/messages" method="post" class="entry-form">
            <input type="text" name="text" placeholder="Ein Eintrag für die Chronik..." required autofocus>
            <button type="submit">Eintragen</button>
        </form>

        <ul class="entries">
            {% for message in messages %}
                <li>
                    <span class="entry-text">{{ message.text }}</span>
                    <span class="entry-time">{{ message.created_at }}</span>
                </li>
            {% else %}
                <li class="entry-empty">Noch keine Einträge in der Chronik.</li>
            {% endfor %}
        </ul>
    </main>
</body>
</html>
