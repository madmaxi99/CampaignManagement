{% extends 'layout.twig' %}
{% block title %}Orte — Weidenmark{% endblock %}
{% block content %}
    <h1>Orte</h1>

    <p class="wiki-actions"><a href="/places/new" class="wiki-new-link">+ Neu anlegen</a></p>

    <ul class="wiki-entries">
        {% for place in places %}
            <li>
                <a href="/places/{{ place.id }}">
                    {% if place.image_path %}
                        <img src="/uploads/places/{{ place.image_path }}" alt="" class="place-thumb">
                    {% endif %}
                    {{ place.name }}
                </a>
            </li>
        {% else %}
            <li class="entry-empty">Noch keine Orte.</li>
        {% endfor %}
    </ul>
{% endblock %}
