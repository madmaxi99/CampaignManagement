    <thead><tr><th>Volk</th><th>Gruß</th><th>Bedeutung</th></tr></thead>
    <tbody>
        <tr><td>Menschen</td><td><strong>Gut'n.</strong></td><td>verkürztes „Guten Tag“, bewusst schlicht</td></tr>
        <tr><td>Elfen</td><td><strong>Sael.</strong></td><td>„Ruhe sei mit dir“, leise und langsam gesprochen</td></tr>
        <tr><td>Zwerge</td><td><strong>Tharn.</strong></td><td>„Steh fest“, mit einem Nicken</td></tr>
        <tr><td>Wolfkin</td><td><strong>Awo.</strong></td><td>klingt wie ein halbes Heulen, locker wie „Servus“</td></tr>
        <tr><td>Mallard</td><td><strong>Plau.</strong></td><td>„Wasser trägt dich“</td></tr>
        <tr><td>Halblinge</td><td><strong>Herdwarm.</strong></td><td>„Warmes Haus“</td></tr>
    </tbody>
