{% extends "layout.twig" %}
{% import "_ui.twig" as ui %}
{% import "rules/_macros.twig" as r %}

{% block title %}Regelwerk{% endblock %}

{% block content %}
    <div class="ui-row page-head">
        <h1>Regelwerk</h1>
    </div>

    <div class="ui-search">
        {{ ui.icon('search') }}
        <input class="ui-input" type="search" id="rules-search" placeholder="Im Regelwerk suchen …" autocomplete="off" aria-label="Regelwerk durchsuchen">
    </div>


    <div class="ui-tabs rules-tabs" role="tablist" data-ui-tabs data-ui-tabs-hash style="margin-top: var(--space-3)">
        <button class="ui-tab" role="tab" id="tab-basics" aria-controls="panel-basics" aria-selected="true">Grundregeln</button>
        <button class="ui-tab" role="tab" id="tab-combat" aria-controls="panel-combat" aria-selected="false">Kampf</button>
        <button class="ui-tab" role="tab" id="tab-spells" aria-controls="panel-spells" aria-selected="false">Magie</button>
        <button class="ui-tab" role="tab" id="tab-character" aria-controls="panel-character" aria-selected="false">Charakter</button>
        <button class="ui-tab" role="tab" id="tab-equipment" aria-controls="panel-equipment" aria-selected="false">Ausrüstung</button>
        <button class="ui-tab" role="tab" id="tab-tables" aria-controls="panel-tables" aria-selected="false">Tabellen</button>
    </div>

    {# ---------- Grundregeln ---------- #}
    <div class="ui-tabpanel ui-stack" id="panel-basics" role="tabpanel" aria-labelledby="tab-basics">
        {{ r.section('wuerfelproben') }}
        {{ r.section('zustaende') }}
        {{ r.section('verletzung_tod') }}
        <h2>Rasten <span class="ui-badge rules-kind">Regel</span></h2>
        {% for t in tables.rest_types %}
            {% set badges %}<span class="ui-badge ui-badge--gold">{{ t.duration_de }}</span>{% endset %}
            {% set body %}<p>{{ t.effect_de }}</p>{% endset %}
            {{ r.entry(t.name_de, t.name_de ~ ' ' ~ t.effect_de, badges, body) }}
        {% endfor %}
        {{ r.section('gefahren_ueberleben') }}
        {% for t in tables.hazards %}
            {% set body %}{% for paragraph in t.description_de|split("\n\n") %}<p>{{ paragraph }}</p>{% endfor %}{% endset %}
            {{ r.entry(t.name_de, t.name_de ~ ' ' ~ t.description_de, '', body) }}
        {% endfor %}
        {{ r.section('reise_wildnis') }}
        {{ r.section('traglast') }}
    </div>

    {# ---------- Kampf ---------- #}
    <div class="ui-tabpanel ui-stack" id="panel-combat" role="tabpanel" aria-labelledby="tab-combat" hidden>
        {% set sta_skills = skills.combat|filter(s => s.attribute_code == 'STA') %}
        {% set gew_skills = skills.combat|filter(s => s.attribute_code == 'GEW') %}

        {{ r.section('ablauf_initiative') }}
        {{ r.section('aktionen_bewegung') }}
        {{ r.section('heimlicher_angriff_hinterhalt') }}
        {{ r.section('gelaende_karten') }}
        {{ r.section('nahkampf', {'STA_SKILLS': sta_skills|map(s => s.name_de)|join(', '), 'GEW_SKILLS': gew_skills|map(s => s.name_de)|join(', ')}) }}
        {{ r.section('parieren_ausweichen') }}
        {{ r.section('besondere_nahkampfangriffe') }}
        {{ r.section('fernkampf') }}
        {{ r.section('ruestung_schaden') }}
        {{ r.section('improvisierte_waffen') }}
    </div>

    {# ---------- Magie ---------- #}
    <div class="ui-tabpanel ui-stack" id="panel-spells" role="tabpanel" aria-labelledby="tab-spells" hidden>
        {{ r.section('magie') }}
        <h2>Zauberliste <span class="ui-badge rules-kind">Liste</span></h2>
        {% for school, data in schools %}
            <h3 class="rules-subhead">{{ school }}</h3>
            {% if data.lore_de %}<p class="ui-muted">{{ data.lore_de }}</p>{% endif %}
            {% for s in data.spells %}
                {% set badges %}
                    <span class="ui-badge ui-badge--gold">{{ s.type == 'trick' ? 'Trick' : 'Zauber' ~ (s.rank ? ' ' ~ s.rank : '') }}</span>
                    <span class="ui-badge ui-badge--sky">{{ s.wp_note_de }}</span>
                {% endset %}
                {% set body %}
                    <dl class="facts">
                        {% if s.components_de %}<div><dt>Vorgabe</dt><dd>{{ s.components_de }}</dd></div>{% endif %}
                        {% if s.casting_time_de %}<div><dt>Zauberdauer</dt><dd>{{ s.casting_time_de }}</dd></div>{% endif %}
                        {% if s.range_de %}<div><dt>Reichweite</dt><dd>{{ s.range_de }}</dd></div>{% endif %}
                        {% if s.duration_de %}<div><dt>Wirkungsdauer</dt><dd>{{ s.duration_de }}</dd></div>{% endif %}
                    </dl>
                    <p>{{ s.effect_de }}</p>
                {% endset %}{{ r.entry(s.name_de, s.name_de ~ ' ' ~ school ~ ' ' ~ s.effect_de, badges, body) }}
            {% endfor %}
        {% endfor %}
    </div>

    {# ---------- Charakter ---------- #}
    <div class="ui-tabpanel ui-stack" id="panel-character" role="tabpanel" aria-labelledby="tab-character" hidden>
        <h2>Völker <span class="ui-badge rules-kind">Liste</span></h2>
        {% for k in kins %}
            {% set badges %}<span class="ui-badge">W12 {{ k.d12_min == k.d12_max ? k.d12_min : k.d12_min ~ '–' ~ k.d12_max }}</span>{% endset %}
            {% set body %}
                <dl class="facts"><div><dt>Grundbewegung</dt><dd>{{ k.movement_base }} m</dd></div></dl>
                {% for a in k.abilities %}
                    <p><strong>{{ a.name_de }}.</strong> {{ a.description_de }}</p>
                {% endfor %}
            {% endset %}{{ r.entry(k.name_de, k.name_de, badges, body) }}
        {% endfor %}
        <h2>Berufe <span class="ui-badge rules-kind">Liste</span></h2>
        {% for p in professions %}
            {% set badges %}<span class="ui-badge">{{ p.key_attribute_de }}</span>{% if p.kin_restriction_de %}<span class="ui-badge ui-badge--gold">nur {{ p.kin_restriction_de }}</span>{% endif %}{% endset %}
            {% set body %}
                <dl class="facts">
                    <div><dt>Schlüsselattribut</dt><dd>{{ p.key_attribute_de }}</dd></div>
                </dl>
                <h3 class="rules-subhead">Fertigkeiten zur Wahl</h3>
                <ul class="rules-skill-list">
                    {% for s in p.skills %}<li>{{ s }}</li>{% endfor %}
                    {% if p.grants_magic %}<li><em>eine gewählte Zauberschule</em></li>{% endif %}
                </ul>
                {% for a in p.abilities %}
                    <p><strong>{{ a.name_de }}.</strong> {{ a.description_de }}</p>
                {% endfor %}
                {% if p.grants_magic %}<p class="ui-muted">Dieser Beruf bringt Zauberei mit.</p>{% endif %}
            {% endset %}{{ r.entry(p.name_de, p.name_de ~ ' ' ~ p.skills|join(' '), badges, body) }}
        {% endfor %}
        {% for group, title in {'regular': 'Fertigkeiten', 'combat': 'Kampffertigkeiten', 'secondary': 'Sekundäre Fertigkeiten'} %}
            <h2>{{ title }} <span class="ui-badge rules-kind">Liste</span></h2>
            {% for s in skills[group] %}
                {% set badges %}<span class="ui-badge">{{ s.attribute_code }}</span>{% endset %}
                {% set body %}
                    <p>{{ s.description_de ?: 'Keine Beschreibung.' }}</p>
                {% endset %}{{ r.entry(s.name_de, s.name_de ~ ' ' ~ s.description_de, badges, body) }}
            {% endfor %}
        {% endfor %}
        <h2>Heldenfähigkeiten <span class="ui-badge rules-kind">Liste</span></h2>
        {% for h in heroicAbilities %}
            {% set badges %}{% if h.wp_note_de %}<span class="ui-badge ui-badge--sky">WP {{ h.wp_note_de }}</span>{% endif %}{% if h.repeatable %}<span class="ui-badge ui-badge--gold">mehrfach</span>{% endif %}{% endset %}
            {% set body %}
                {% if h.requirement_de %}<p class="ui-muted">Voraussetzung: {{ h.requirement_de }}</p>{% endif %}
                <p>{{ h.description_de }}</p>
            {% endset %}{{ r.entry(h.name_de, h.name_de ~ ' ' ~ h.description_de, badges, body) }}
        {% endfor %}
        {{ r.section('erfahrung_steigern') }}
    </div>

    {# ---------- Ausrüstung ---------- #}
    <div class="ui-tabpanel ui-stack" id="panel-equipment" role="tabpanel" aria-labelledby="tab-equipment" hidden>
        {% for group, title in {'weapon': 'Waffen', 'armor': 'Rüstungen', 'misc': 'Ausrüstung'} %}
            <h2>{{ title }} <span class="ui-badge rules-kind">Liste</span></h2>
            {% for i in items[group] %}
                {% set badges %}
                    {% if group == 'weapon' %}<span class="ui-badge ui-badge--berry">{{ i.damage_de }}</span>{% endif %}
                    {% if group == 'armor' %}<span class="ui-badge ui-badge--sky">RS {{ i.armor_value }}</span>{% endif %}
                    <span class="ui-badge ui-badge--gold">{{ i.price_de }}</span>
                {% endset %}
                {% set body %}
                    <p>{{ i.description_de }}</p>
                    <dl class="facts">
                        {% if group == 'weapon' %}
                            <div><dt>Griff</dt><dd>{{ i.grip_de }}</dd></div>
                            <div><dt>Reichweite</dt><dd>{{ i.range_de }}</dd></div>
                            <div><dt>Schaden</dt><dd>{{ i.damage_de }}</dd></div>
                            {% if i.str_requirement %}<div><dt>Benötigte STA</dt><dd>{{ i.str_requirement }}</dd></div>{% endif %}
                            {% if i.durability %}<div><dt>Haltbarkeit</dt><dd>{{ i.durability }}</dd></div>{% endif %}
                            {% if i.traits_de %}<div><dt>Merkmale</dt><dd>{{ i.traits_de }}</dd></div>{% endif %}
                        {% elseif group == 'armor' %}
                            <div><dt>Platz</dt><dd>{{ i.armor_slot == 'head' ? 'Kopf' : 'Körper' }}</dd></div>
                            <div><dt>Rüstungswert</dt><dd>{{ i.armor_value }}</dd></div>
                            {% if i.armor_penalties %}<div><dt>Abzüge</dt><dd>{{ i.armor_penalties|join(', ') }}</dd></div>{% endif %}
                        {% endif %}
                        {% if group == 'misc' %}
                            {% set weight = i.weight + 0 %}
                            <div><dt>Gewicht</dt><dd>{{ weight == 0 ? 'Kleinkram' : (weight == 0.25 ? '¼' : weight|number_format(0)) }}</dd></div>
                        {% endif %}
                        <div><dt>Seltenheit</dt><dd>{{ i.rarity }}</dd></div>
                        <div><dt>Preis</dt><dd>{{ i.price_de }}</dd></div>
                    </dl>
                {% endset %}{{ r.entry(i.name_de, i.name_de ~ ' ' ~ i.description_de, badges, body) }}
            {% endfor %}
        {% endfor %}
        <h2>Dienste <span class="ui-badge rules-kind">Liste</span></h2>
        {% for sv in services %}
            {% set badges %}<span class="ui-badge ui-badge--gold">{{ sv.price_de }}{{ sv.unit_de ? ' ' ~ sv.unit_de : '' }}</span>{% endset %}
            {% set body %}
                <p>{{ sv.effect_de }}</p>
                <dl class="facts">
                    <div><dt>Seltenheit</dt><dd>{{ sv.rarity }}</dd></div>
                    <div><dt>Preis</dt><dd>{{ sv.price_de }}{{ sv.unit_de ? ' ' ~ sv.unit_de : '' }}</dd></div>
                </dl>
            {% endset %}{{ r.entry(sv.name_de, sv.name_de ~ ' ' ~ sv.effect_de, badges, body) }}
        {% endfor %}
    </div>

    {# ---------- Tabellen ---------- #}
    <div class="ui-tabpanel ui-stack" id="panel-tables" role="tabpanel" aria-labelledby="tab-tables" hidden>
        <h2>Wurftabellen <span class="ui-badge rules-kind">Tabelle</span></h2>
        <details class="ui-details" data-search="verletzungen wounded table">
            <summary><span class="ui-details__title">{{ ui.icon('heart') }} Verletzungen (W20)</span></summary>
            <div class="ui-details__body">
            <table class="ui-table ui-table--cards">
                <thead><tr><th>Wurf</th><th>Verletzung</th><th>Wirkung</th><th>Heilung</th></tr></thead>
                <tbody>
                    {% for t in tables.injuries %}
                        <tr><td data-label="Wurf">{{ r.roll(t.roll_min, t.roll_max) }}</td><td data-label="Verletzung"><strong>{{ t.name_de }}</strong></td><td data-label="Wirkung">{{ t.effect_de }}</td><td data-label="Heilung">{{ t.healing_de ?: '–' }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        </details>

        {% for key, title in {'combat_mishaps_melee': 'Nahkampf-Patzer', 'combat_mishaps_ranged': 'Fernkampf-Patzer', 'magical_mishaps': 'Magische Patzer'} %}
            <details class="ui-details" data-search="{{ title|lower }} patzer">
            <summary><span class="ui-details__title">{{ ui.icon('dices') }} {{ title }}</span></summary>
            <div class="ui-details__body">
                <table class="ui-table ui-table--cards">
                    <thead><tr><th>Wurf</th><th>Wirkung</th></tr></thead>
                    <tbody>{% for t in tables[key] %}<tr><td data-label="Wurf">{{ t.roll }}</td><td data-label="Wirkung">{{ t.effect_de }}</td></tr>{% endfor %}</tbody>
                </table>
            </div>
        </details>
        {% endfor %}

        <details class="ui-details" data-search="furcht angst">
            <summary><span class="ui-details__title">{{ ui.icon('skull') }} Furcht</span></summary>
            <div class="ui-details__body">
            <table class="ui-table ui-table--cards">
                <thead><tr><th>Wurf</th><th>Ereignis</th><th>Wirkung</th></tr></thead>
                <tbody>{% for t in tables.fear_events %}<tr><td data-label="Wurf">{{ t.roll }}</td><td data-label="Ereignis"><strong>{{ t.name_de }}</strong></td><td data-label="Wirkung">{{ t.effect_de }}</td></tr>{% endfor %}</tbody>
            </table>
        </div>
        </details>

        {% for group_tables in tables.roll_tables %}
            {% for t in group_tables|filter(t => t.code == 'jagd') %}{{ r.rolltable(t) }}{% endfor %}
        {% endfor %}
    </div>


    <div class="ui-empty" data-rules-empty hidden>
        {{ ui.icon('search') }}
        <strong>Nichts gefunden</strong>
        <span>Probier einen anderen Suchbegriff.</span>
    </div>

    <script type="module" src="{{ asset('js/rules.js') }}"></script>
{% endblock %}
