{% macro render(heading, defaultCards, customCards, emptyMessage) %}
<div class="characters-page">
    <h1>{{ heading }}</h1>

    <section class="character-section">
        <h2>Default</h2>
        <div class="character-grid">
            {% for card in defaultCards %}
                {{ card }}
            {% endfor %}
        </div>
    </section>

    <section class="character-section">
        <h2>Selbsterstellt</h2>
        <div class="character-grid">
            {% for card in customCards %}
                {{ card }}
            {% else %}
                <p class="character-section-empty">{{ emptyMessage }}</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endmacro %}
