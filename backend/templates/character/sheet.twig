{% extends "layout.twig" %}

{% block title %}{{ character.name_de }}{% endblock %}

{% macro skill_list(skills, category, listId) %}
    <ul class="entry-list"{% if listId %} id="{{ listId }}"{% endif %}>
        {% for skill in skills %}
            <li class="entry-row" data-detail="{{ {'type': 'skill', 'id': skill.id, 'name': skill.name_de, 'attribute': skill.attribute_code, 'category': category, 'value': skill.value}|json_encode|e('html_attr') }}">
                <label class="mark-checkbox" title="Markiere ihn, wenn du nicht bestanden hast." onclick="event.stopPropagation()">
                    <input type="checkbox" class="skill-mark" data-skill-id="{{ skill.id }}" {% if skill.marked_for_advancement %}checked{% endif %}>
                </label>
                <span class="entry-name">{{ skill.name_de }} <small>({{ skill.attribute_code }})</small></span>
                <span class="entry-value">{{ skill.value }}</span>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% import _self as sheet_macros %}

{% block content %}
<div class="sheet" data-id="{{ character.id }}">

    <header class="sheet-header">
        <div class="sheet-header-inner">
            {% if character.portrait_path %}
                <img class="sheet-portrait" src="/{{ character.portrait_path }}" alt="{{ character.name_de }}">
            {% else %}
                <form id="portrait-upload-form" class="sheet-portrait-upload" enctype="multipart/form-data">
                    <label for="portrait-upload-input">Kein Bild</label>
                    <input type="file" id="portrait-upload-input" name="portrait" accept="image/jpeg,image/png,image/webp" required>
                    <button type="submit">Hochladen</button>
                </form>
            {% endif %}
            <div class="sheet-header-text">
                <div class="sheet-header-title-row">
                    <h1>{{ character.name_de }}</h1>
                    {% if not character.is_default %}
                        <button type="button" id="delete-character-button" class="button-danger">Charakter löschen</button>
                    {% endif %}
                </div>
                <dl class="sheet-header-facts">
                    <div><dt>Volk</dt><dd>{{ character.kin_de }}</dd></div>
                    <div><dt>Alter</dt><dd>{{ character.age_de }}</dd></div>
                    <div><dt>Beruf</dt><dd>{{ character.profession_de }}</dd></div>
                    <div><dt>Schwäche</dt><dd>{{ character.flaw_de }}</dd></div>
                    {% if character.memento_de %}
                        <div><dt>Memento</dt><dd>{{ character.memento_de }}</dd></div>
                    {% endif %}
                </dl>
                <p class="appearance">{{ character.appearance_de }}</p>
            </div>
        </div>
    </header>

    <section class="card attributes">
        <h2>Attribute</h2>
        <div class="attribute-grid">
            {% for attribute in attributes %}
                <div class="attribute">
                    <div class="attribute-code">{{ attribute.code }}</div>
                    <div class="attribute-value">{{ attribute.value }}</div>
                    <div class="attribute-name">{{ attribute.name_de }}</div>
                    {% for condition in conditions %}
                        {% if condition.attribute_code == attribute.code %}
                            <button type="button"
                                    class="condition-chip{% if condition.active %} active{% endif %}"
                                    data-condition-code="{{ condition.code }}">
                                {{ condition.name_de }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
        <div class="derived-stats">
            <div><span class="label">Bewegung</span><span class="value">{{ character.movement }} m</span></div>
            <div><span class="label">Traglast</span><span class="value">{{ character.carrying_capacity }}</span></div>
            <div><span class="label">Schadensbonus (STA)</span><span class="value">{{ character.damage_bonus_sta_de }}</span></div>
            <div><span class="label">Schadensbonus (GEW)</span><span class="value">{{ character.damage_bonus_gew_de }}</span></div>
        </div>
    </section>

    <section class="card vitals">
        <h2>Trefferpunkte &amp; Willenskraft</h2>
        <div class="vital-tracker" data-vital="hp" data-max="{{ character.hp_max }}" data-current="{{ character.hp_current }}">
            <span class="vital-label">TP</span>
            <div class="pips">
                {% for i in 1..character.hp_max %}
                    <button type="button" class="pip{% if i <= character.hp_current %} filled{% endif %}" data-index="{{ i }}"></button>
                {% endfor %}
            </div>
            <span class="vital-count">{{ character.hp_current }} / {{ character.hp_max }}</span>
        </div>
        <div class="vital-tracker" data-vital="wp" data-max="{{ character.wp_max }}" data-current="{{ character.wp_current }}">
            <span class="vital-label">WP</span>
            <div class="pips">
                {% for i in 1..character.wp_max %}
                    <button type="button" class="pip{% if i <= character.wp_current %} filled{% endif %}" data-index="{{ i }}"></button>
                {% endfor %}
            </div>
            <span class="vital-count">{{ character.wp_current }} / {{ character.wp_max }}</span>
        </div>
    </section>

    <section class="card skills-spells">
        <div class="card-heading-row">
            <h2>Fertigkeiten &amp; Zauber</h2>
            <button type="button" id="downtime-button">Downtime</button>
        </div>

        <h3>Fertigkeiten</h3>
        {{ sheet_macros.skill_list(regularSkills, 'regular', 'regular-skills-list') }}

        <h3>Kampffertigkeiten</h3>
        {{ sheet_macros.skill_list(combatSkills, 'combat') }}

        <h3>Sekundäre Fertigkeiten</h3>
        {{ sheet_macros.skill_list(secondarySkills, 'secondary') }}

        <h3>Zauber &amp; Tricks</h3>
        <ul class="entry-list">
            {% for spell in spells %}
                <li class="entry-row" data-detail="{{ {'type': 'spell', 'name': spell.name_de, 'components': spell.components_de, 'castingTime': spell.casting_time_de, 'range': spell.range_de, 'duration': spell.duration_de, 'wpNote': spell.wp_note_de, 'effect': spell.effect_de}|json_encode|e('html_attr') }}">
                    <span class="entry-name">{{ spell.name_de }}</span>
                    <span class="entry-value">{{ spell.wp_note_de }}</span>
                </li>
            {% endfor %}
        </ul>
        {% if isCaster %}
            <div class="spell-add-menu">
                <label for="learn-spell-select">Neuen Zauber/Trick lernen</label>
                <div class="add-form">
                    <select id="learn-spell-select">
                        <option value="">Auswählen…</option>
                        {% for spell in availableSpells %}
                            <option value="{{ spell.id }}">{{ spell.name_de }}</option>
                        {% endfor %}
                    </select>
                    <button type="button" id="learn-spell-button">Lernen</button>
                </div>
            </div>
        {% endif %}

        <h3>Talente</h3>
        <ul class="talent-list">
            {% for talent in talents %}
                <li>
                    <span class="talent-name">{{ talent.name_de }}{% if talent.wp_note_de %} <small>({{ talent.wp_note_de }})</small>{% endif %}</span>
                    <p class="talent-description">{{ talent.description_de }}</p>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="card equipment-list">
        <div class="card-heading-row">
            <h2>Waffen</h2>
            <button type="button" class="add-row-button" data-segment="weapons">+ Waffe hinzufügen</button>
        </div>
        <table class="item-table" id="weapons-table">
            <thead>
                <tr><th>Name</th><th>Griff</th><th>Reichweite</th><th>Schaden</th><th>Merkmale/Beschreibung</th><th></th></tr>
            </thead>
            <tbody>
                {% for weapon in weapons %}
                    <tr data-row-id="{{ weapon.row_id }}">
                        <td><input type="text" class="free-text-field" data-segment="weapons" data-row-id="{{ weapon.row_id }}" data-field="name_de" value="{{ weapon.name_de }}"></td>
                        <td><input type="text" class="free-text-field" data-segment="weapons" data-row-id="{{ weapon.row_id }}" data-field="grip_de" value="{{ weapon.grip_de }}"></td>
                        <td><input type="text" class="free-text-field" data-segment="weapons" data-row-id="{{ weapon.row_id }}" data-field="range_de" value="{{ weapon.range_de }}"></td>
                        <td><input type="text" class="free-text-field" data-segment="weapons" data-row-id="{{ weapon.row_id }}" data-field="damage_de" value="{{ weapon.damage_de }}"></td>
                        <td><input type="text" class="free-text-field" data-segment="weapons" data-row-id="{{ weapon.row_id }}" data-field="traits_de" value="{{ weapon.traits_de }}"></td>
                        <td><button type="button" class="remove-button" data-segment="weapons" data-row-id="{{ weapon.row_id }}">✕</button></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="card equipment-list">
        <div class="card-heading-row">
            <h2>Rüstung</h2>
        </div>
        <table class="item-table" id="armor-table">
            <thead>
                <tr><th>Slot</th><th>Name</th><th>Rüstungswert</th><th>Nachteil</th></tr>
            </thead>
            <tbody>
                {% for piece in armor %}
                    <tr data-slot="{{ piece.slot }}">
                        <td>{{ piece.slot == 'body' ? 'Körper' : 'Kopf' }}</td>
                        <td><input type="text" class="free-text-field" data-segment="armor" data-slot="{{ piece.slot }}" data-field="name_de" value="{{ piece.name_de }}"></td>
                        <td><input type="number" class="free-text-field" data-segment="armor" data-slot="{{ piece.slot }}" data-field="armor_value" value="{{ piece.armor_value }}"></td>
                        <td><input type="text" class="free-text-field" data-segment="armor" data-slot="{{ piece.slot }}" data-field="penalty_de" value="{{ piece.penalty_de }}"></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="card equipment-list">
        <div class="card-heading-row">
            <h2>Inventar</h2>
            <button type="button" class="add-row-button" data-segment="inventory">+ Gegenstand hinzufügen</button>
        </div>
        <table class="item-table" id="inventory-table">
            <thead>
                <tr><th>Name</th><th>Beschreibung</th><th>Menge</th><th></th></tr>
            </thead>
            <tbody>
                {% for item in inventory %}
                    <tr data-row-id="{{ item.row_id }}">
                        <td><input type="text" class="free-text-field" data-segment="inventory" data-row-id="{{ item.row_id }}" data-field="name_de" value="{{ item.name_de }}"></td>
                        <td><input type="text" class="free-text-field" data-segment="inventory" data-row-id="{{ item.row_id }}" data-field="description_de" value="{{ item.description_de }}"></td>
                        <td><input type="number" class="free-text-field" data-segment="inventory" data-row-id="{{ item.row_id }}" data-field="quantity" value="{{ item.quantity }}" min="0"></td>
                        <td><button type="button" class="remove-button" data-segment="inventory" data-row-id="{{ item.row_id }}">✕</button></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="card currency">
        <h2>Münzen</h2>
        <div class="currency-fields">
            <label>Gold <input type="number" id="coins-gold" value="{{ character.coins_gold }}" min="0"></label>
            <label>Silber <input type="number" id="coins-silver" value="{{ character.coins_silver }}" min="0"></label>
            <label>Kupfer <input type="number" id="coins-copper" value="{{ character.coins_copper }}" min="0"></label>
            <button type="button" id="currency-save-button">Speichern</button>
        </div>
    </section>

</div>

<dialog class="entity-modal" id="detail-modal">
    <button type="button" class="entity-modal-close" id="detail-modal-close" aria-label="Schließen">×</button>
    <div class="entity-modal-body" id="detail-modal-content"></div>
</dialog>

<dialog class="entity-modal" id="downtime-modal">
    <button type="button" class="entity-modal-close" id="downtime-modal-close" aria-label="Schließen">×</button>
    <div class="entity-modal-body">
        <h2>Downtime — Markierte Fertigkeiten</h2>
        <ul class="downtime-list" id="downtime-list">
            {% for skill in markedSkills %}
                <li data-skill-id="{{ skill.id }}">
                    <span class="entry-name">{{ skill.name_de }} <small>({{ skill.attribute_code }})</small></span>
                    <span class="entry-value" data-current-value>{{ skill.value }}</span>
                    <button type="button" class="advance-button" data-apply="1" data-skill-id="{{ skill.id }}">Aufleveln</button>
                    <button type="button" class="advance-button" data-apply="0" data-skill-id="{{ skill.id }}">Verwerfen</button>
                </li>
            {% else %}
                <li class="downtime-empty">Keine markierten Fertigkeiten.</li>
            {% endfor %}
        </ul>
    </div>
</dialog>

<script src="/js/character-sheet.js"></script>
{% endblock %}
