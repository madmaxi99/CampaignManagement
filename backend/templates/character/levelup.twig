{% extends "layout.twig" %}
{% import "_ui.twig" as ui %}

{% block title %}Level-up – {{ character.name_de }}{% endblock %}

{% block content %}
<div class="levelup ui-stack" data-id="{{ character.id }}">

    <div class="ui-row page-head">
        <a class="ui-btn ui-btn--ghost ui-btn--small" href="/character/{{ character.id }}">{{ ui.icon('arrow-left') }} Zum Bogen</a>
        <h1>Level-up</h1>
    </div>
    <p class="ui-muted">{{ character.name_de }} · Entscheide dich unten und speichere alles zusammen. Bis dahin ändert sich nichts.</p>

    <section class="ui-card">
        <h2 class="ui-card__title">{{ ui.icon('swords') }} Fertigkeiten</h2>
        {% if markedSkills is empty %}
            <p class="ui-muted">Keine markierten Fertigkeiten. Markiere am Bogen Fertigkeiten, bei denen eine Probe nicht bestanden wurde.</p>
        {% else %}
            <ul class="levelup-list">
                {% for skill in markedSkills %}
                    <li class="levelup-item" data-skill-id="{{ skill.id }}">
                        <div class="levelup-item__head">
                            <strong>{{ skill.name_de }} <small>({{ skill.attribute_code }})</small></strong>
                            <span class="ui-badge">{{ skill.value }}</span>
                        </div>
                        <div class="segmented" role="group" aria-label="{{ skill.name_de }}">
                            <button type="button" class="segmented__option" aria-pressed="false" data-decision="apply" data-skill-id="{{ skill.id }}">{{ ui.icon('star') }} Steigern</button>
                            <button type="button" class="segmented__option" aria-pressed="false" data-decision="discard" data-skill-id="{{ skill.id }}">Verwerfen</button>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="ui-card">
        <h2 class="ui-card__title">{{ ui.icon('crown') }} Heldenfähigkeiten</h2>
        {% if learnableHeroicAbilities is empty %}
            <p class="ui-muted">Keine wählbaren Heldenfähigkeiten.</p>
        {% else %}
            <ul class="levelup-list">
                {% for ability in learnableHeroicAbilities %}
                    <li class="levelup-item" data-ability-id="{{ ability.id }}">
                        <div class="levelup-item__head">
                            <strong>{{ ability.name_de }}</strong>
                            <span>
                                {% if ability.wp_note_de %}<span class="ui-badge ui-badge--sky">WP {{ ability.wp_note_de }}</span>{% endif %}
                                {% if ability.repeatable and ability.times_owned > 0 %}<span class="ui-badge ui-badge--gold">{{ ability.times_owned }}× gewählt</span>{% endif %}
                            </span>
                        </div>
                        {% if ability.requirement_de %}<p class="ui-muted">Voraussetzung: {{ ability.requirement_de }}</p>{% endif %}
                        <p>{{ ability.description_de }}</p>
                        {% if ability.name_de == 'Magisches Talent' %}
                            <div class="ui-field">
                                <label>Neue Zauberschule</label>
                                <select class="ui-select" data-school-select {% if untrainedSchoolSkills is empty %}disabled{% endif %}>
                                    {% if untrainedSchoolSkills is empty %}
                                        <option value="">Alle Schulen bereits erlernt</option>
                                    {% else %}
                                        {% for skill in untrainedSchoolSkills %}<option value="{{ skill.id }}">{{ skill.name_de }}</option>{% endfor %}
                                    {% endif %}
                                </select>
                            </div>
                        {% endif %}
                        <button type="button" class="ui-btn ui-btn--gold ui-btn--small" data-learn-ability="{{ ability.id }}">Lernen</button>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="ui-card">
        <h2 class="ui-card__title">{{ ui.icon('wand-sparkles') }} Zauber &amp; Tricks</h2>
        {% if availableSpells is empty %}
            <p class="ui-muted">Keine lernbaren Zauber oder Tricks.</p>
        {% else %}
            <ul class="levelup-list">
                {% for spell in availableSpells %}
                    <li class="levelup-item" data-spell-id="{{ spell.id }}">
                        <div class="levelup-item__head">
                            <strong>{{ spell.name_de }}</strong>
                            <span class="ui-badge ui-badge--sky">{{ spell.wp_note_de }}</span>
                        </div>
                        <dl class="facts">
                            {% if spell.components_de %}<div><dt>Vorgabe</dt><dd>{{ spell.components_de }}</dd></div>{% endif %}
                            {% if spell.casting_time_de %}<div><dt>Zauberdauer</dt><dd>{{ spell.casting_time_de }}</dd></div>{% endif %}
                            {% if spell.range_de %}<div><dt>Reichweite</dt><dd>{{ spell.range_de }}</dd></div>{% endif %}
                            {% if spell.duration_de %}<div><dt>Wirkungsdauer</dt><dd>{{ spell.duration_de }}</dd></div>{% endif %}
                        </dl>
                        <p>{{ spell.effect_de }}</p>
                        <button type="button" class="ui-btn ui-btn--gold ui-btn--small" data-learn-spell="{{ spell.id }}">Lernen</button>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <div class="action-bar">
        <a class="ui-btn ui-btn--ghost" href="/character/{{ character.id }}">Abbrechen</a>
        <button type="button" class="ui-btn" id="levelup-save">{{ ui.icon('check') }} Speichern <span class="ui-badge ui-badge--gold" data-pending-count hidden></span></button>
    </div>
</div>

<script type="module" src="{{ asset('js/character-levelup.js') }}"></script>
{% endblock %}
