{% extends 'layout.twig' %}
{% block title %}Kins — Regelwerk{% endblock %}
{% block content %}
    <h1>Kins</h1>

    <table class="ref-table">
        <thead>
            <tr><th>Name</th><th>Movement</th><th>Abilities</th></tr>
        </thead>
        <tbody>
            {% for kin in kins %}
                <tr>
                    <td>{{ kin.name }}</td>
                    <td>{{ kin.base_movement }}</td>
                    <td>
                        {% for ability in abilities[kin.id] ?? [] %}
                            <strong>{{ ability.name }}</strong>{% if ability.wp_cost %} (WP {{ ability.wp_cost }}){% endif %}: {{ ability.description }}<br>
                        {% else %}
                            &mdash;
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
