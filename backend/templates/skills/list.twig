{% extends 'layout.twig' %}
{% block title %}Skills — Regelwerk{% endblock %}
{% block content %}
    <h1>Skills</h1>

    <table class="ref-table">
        <thead>
            <tr><th>Name</th><th>Attribut</th><th>Beschreibung</th></tr>
        </thead>
        <tbody>
            {% for skill in skills %}
                <tr>
                    <td>{{ skill.name }}</td>
                    <td>{{ skill.governing_attribute }}</td>
                    <td>{{ skill.description }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
