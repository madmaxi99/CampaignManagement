{% extends 'layout.twig' %}
{% block title %}{{ category.label }} — Weidenmark{% endblock %}
{% block content %}
    <h1>{{ category.label }}</h1>

    <p class="wiki-actions"><a href="/wiki/{{ slug }}/new" class="wiki-new-link">+ Neu anlegen</a></p>

    <ul class="wiki-entries">
        {% for entry in entries %}
            <li><a href="/wiki/{{ slug }}/{{ entry.id }}/edit">{{ entry[category.columns[0].name] }}</a></li>
        {% else %}
            <li class="entry-empty">Noch keine Einträge.</li>
        {% endfor %}
    </ul>
{% endblock %}
