<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{{ category.label }} — Wiki</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="page">
        <h1>{{ category.label }}</h1>
        {% include 'wiki/_tabs.twig' %}

        <p class="wiki-actions"><a href="/dm/wiki/{{ slug }}/new" class="wiki-new-link">+ Neu anlegen</a></p>

        <ul class="wiki-entries">
            {% for entry in entries %}
                <li><a href="/dm/wiki/{{ slug }}/{{ entry.id }}/edit">{{ entry[category.columns[0].name] }}</a></li>
            {% else %}
                <li class="entry-empty">Noch keine Einträge.</li>
            {% endfor %}
        </ul>
    </main>
</body>
</html>
