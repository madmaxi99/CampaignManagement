{% extends 'layout.twig' %}
{% block title %}Heroic Abilities — Regelwerk{% endblock %}
{% block content %}
    <h1>Heroic Abilities</h1>

    <table class="ref-table">
        <thead>
            <tr><th>Name</th><th>Requirement</th><th>WP</th><th>Beschreibung</th></tr>
        </thead>
        <tbody>
            {% for ability in abilities %}
                <tr>
                    <td>{{ ability.name }}</td>
                    <td>{{ ability.requirement ?: '—' }}</td>
                    <td>{{ ability.wp_cost ?? '—' }}</td>
                    <td>{{ ability.description }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
