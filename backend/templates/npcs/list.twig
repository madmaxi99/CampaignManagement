{% extends 'layout.twig' %}
{% block title %}NSCs — Kampagne{% endblock %}
{% block content %}
    <h1>NSCs</h1>

    <table class="ref-table">
        <thead>
            <tr><th>Name</th><th>Kin</th><th>Ferocity</th><th>Movement</th><th>Armor</th><th>HP</th><th>WP</th></tr>
        </thead>
        <tbody>
            {% for npc in npcs %}
                <tr>
                    <td>{{ npc.name }}</td>
                    <td>{{ npc.kin ?: '—' }}</td>
                    <td>{{ npc.ferocity ?? '—' }}</td>
                    <td>{{ npc.movement ?? '—' }}</td>
                    <td>{{ npc.armor ?? '—' }}</td>
                    <td>{{ npc.hp }}</td>
                    <td>{{ npc.wp }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="entry-empty">Noch keine NSCs.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
