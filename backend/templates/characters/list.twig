{% extends 'layout.twig' %}
{% block title %}Charaktere — Kampagne{% endblock %}
{% block content %}
    <h1>Charaktere</h1>

    <p class="wiki-actions"><a href="/characters/new" class="wiki-new-link">+ Neuen Charakter erstellen</a></p>

    <ul class="char-list">
        {% for character in characters %}
            <li>
                <a href="/characters/{{ character.id }}" class="char-list-item">
                    <span class="char-list-name">{{ character.name }}</span>
                    <span class="char-list-meta">{{ character.kin_name }} · {{ character.profession_name }} · HP {{ character.hp_current }}/{{ character.hp_max }} · WP {{ character.wp_current }}/{{ character.wp_max }}</span>
                </a>
            </li>
        {% else %}
            <li class="entry-empty">Noch keine Charaktere.</li>
        {% endfor %}
    </ul>
{% endblock %}
