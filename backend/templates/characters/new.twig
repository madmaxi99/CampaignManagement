{% extends 'layout.twig' %}
{% block title %}Neuer Charakter — Weidenmark{% endblock %}
{% block content %}
    <h1>Neuer Charakter</h1>
    <p class="subtitle">Digitaler Charakterbogen — gewürfelt wird am Tisch, hier trägst du nur ein.</p>

    {% if error %}
        <p class="wiki-error">{{ error }}</p>
    {% endif %}

    <script type="application/json" id="character-data">{{ character_data|raw }}</script>

    <form method="post" action="/characters" class="wiki-form" id="character-form">

        <section class="char-section">
            <h2>1. Kin</h2>
            <label class="wiki-field">
                <span>Kin</span>
                <select name="kin_id" id="kin-select" required>
                    <option value="">— wählen —</option>
                    {% for kin in kins %}
                        <option value="{{ kin.id }}">{{ kin.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <div id="kin-abilities" class="char-hint"></div>
        </section>

        <section class="char-section">
            <h2>2. Profession</h2>
            <label class="wiki-field">
                <span>Profession</span>
                <select name="profession_id" id="profession-select" required>
                    <option value="">— wählen —</option>
                    {% for profession in professions %}
                        <option value="{{ profession.id }}">{{ profession.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <div id="mage-tradition-field" class="wiki-field" hidden>
                <span>Magic Tradition</span>
                <select name="magic_tradition" id="magic-tradition-select">
                    <option value="">— wählen —</option>
                    <option value="elementalist">Elementalist</option>
                    <option value="mentalist">Mentalist</option>
                    <option value="animist">Animist</option>
                </select>
            </div>

            <p class="char-hint"><strong>Core Skills:</strong> <span id="profession-core-skills">—</span></p>
        </section>

        <section class="char-section">
            <h2>3. Alter</h2>
            <label class="wiki-field">
                <span>Alter</span>
                <select name="age" id="age-select" required>
                    <option value="">— wählen —</option>
                    <option value="young">Young</option>
                    <option value="adult">Adult</option>
                    <option value="old">Old</option>
                </select>
            </label>
            <p class="char-hint" id="age-hint"></p>
        </section>

        <section class="char-section">
            <h2>4. Name</h2>
            <label class="wiki-field">
                <span>Name</span>
                <input type="text" name="name" required>
            </label>
        </section>

        <section class="char-section">
            <h2>5. Attribute</h2>
            <div class="char-grid">
                {% for attr in ['str', 'con', 'agl', 'int', 'wil', 'cha'] %}
                    <label class="wiki-field">
                        <span>{{ attr|upper }}</span>
                        <input type="number" min="3" max="18" name="attribute_{{ attr }}" id="attr-{{ attr }}" class="attr-input" required>
                    </label>
                {% endfor %}
            </div>
            <div class="char-derived" id="derived-values">
                Movement: — &middot; Damage Bonus STR: — &middot; Damage Bonus AGL: — &middot; HP: — &middot; WP: —
            </div>
        </section>

        <section class="char-section">
            <h2>6. Skills</h2>
            <p class="char-hint">Die Core Skills deiner Profession sind automatisch trainiert. Zusätzlich frei wählbar (Anzahl je nach Alter): <span id="extra-skills-hint">0 / 0 ausgewählt</span></p>
            <ul class="char-skill-list" id="extra-skills-list"></ul>
        </section>

        <section class="char-section" id="ha-section">
            <h2>7. Heroic Ability</h2>
            <p class="char-hint">Vorschlag deiner Profession ist vorausgewählt, du kannst aber frei wechseln.</p>
            <ul class="char-ability-list" id="ha-list"></ul>
        </section>

        <section class="char-section" id="spell-section" hidden>
            <h2>7. Zauber</h2>
            <p class="char-hint">Als Mage wählst du 3 Rank-1-Zauber deiner Tradition sowie 3 Magic Tricks aus deiner Tradition oder aus General Magic. Du erhältst automatisch ein Grimoire.</p>
            <p class="char-hint"><strong>Rank-1-Zauber</strong> (<span id="spell-rank1-count">0</span> / 3)</p>
            <ul class="char-spell-list" id="spell-rank1-list"></ul>
            <p class="char-hint"><strong>Magic Tricks</strong> (<span id="spell-trick-count">0</span> / 3)</p>
            <ul class="char-spell-list" id="spell-trick-list"></ul>
        </section>

        <section class="char-section">
            <h2>8. Weakness (optional)</h2>
            <label class="wiki-field">
                <span>Weakness</span>
                <select name="weakness" id="weakness-select"></select>
            </label>
        </section>

        <section class="char-section">
            <h2>9. Ausrüstung</h2>
            <div id="gear-rows"></div>
        </section>

        <section class="char-section">
            <h2>10. Sprachen</h2>
            <label class="wiki-field">
                <span>Sprachen (Common Tongue gilt immer, weitere frei eintragen)</span>
                <input type="text" name="languages" placeholder="Common Tongue, ...">
            </label>
        </section>

        <section class="char-section">
            <h2>11. Memento (optional)</h2>
            <label class="wiki-field">
                <span>Memento</span>
                <textarea name="memento" rows="2"></textarea>
            </label>
        </section>

        <section class="char-section">
            <h2>12. Appearance</h2>
            <label class="wiki-field">
                <span>Appearance</span>
                <textarea name="appearance" rows="3"></textarea>
            </label>
        </section>

        <button type="submit">Charakter anlegen</button>
    </form>

    <script src="/js/character-create.js"></script>
{% endblock %}
