{% extends 'layout.twig' %}
{% block title %}{{ character.name }} — Charakterbogen{% endblock %}
{% block content %}
    <div class="sheet-header">
        <div>
            <h1>{{ character.name }}</h1>
            <p class="sheet-meta">{{ character.kin_name }} · {{ character.profession_name }} · {{ character.age }}{% if character.magic_tradition %} · {{ character.magic_tradition|capitalize }}{% endif %}</p>
        </div>
    </div>

    <form method="post" action="/characters/{{ character.id }}/vitals">
        <div class="sheet-vitals">
            <div class="sheet-vital">
                <label>HP</label>
                <input type="number" name="hp_current" value="{{ character.hp_current }}" min="0" max="{{ character.hp_max }}"> / {{ character.hp_max }}
            </div>
            <div class="sheet-vital">
                <label>WP</label>
                <input type="number" name="wp_current" value="{{ character.wp_current }}" min="0" max="{{ character.wp_max }}"> / {{ character.wp_max }}
            </div>
            <div class="sheet-vital">
                <label>Movement</label>
                {{ character.movement }}
            </div>
            <div class="sheet-vital">
                <label>Damage Bonus STR</label>
                {{ character.damage_bonus_str }}
            </div>
            <div class="sheet-vital">
                <label>Damage Bonus AGL</label>
                {{ character.damage_bonus_agl }}
            </div>
        </div>

        <div class="sheet-conditions">
            {% for condition in ['exhausted', 'sickly', 'dazed', 'angry', 'scared', 'disheartened'] %}
                <label>
                    <input type="checkbox" name="condition_{{ condition }}" value="1"{% if character['condition_' ~ condition] %} checked{% endif %}>
                    {{ condition|capitalize }}
                </label>
            {% endfor %}
        </div>

        <button type="submit" class="btn-secondary">Aktualisieren</button>
    </form>

    <div class="sheet-section">
        <h2>Attribute</h2>
        <div class="sheet-attributes">
            {% for attr in ['str', 'con', 'agl', 'int', 'wil', 'cha'] %}
                <div class="sheet-attribute">
                    <span class="sheet-attribute-label">{{ attr|upper }}</span>
                    <span class="sheet-attribute-value">{{ character['attribute_' ~ attr] }}</span>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="sheet-section">
        <h2>Skills</h2>
        <ul class="sheet-skill-list">
            {% for skill in all_skills %}
                {% set trained = trained_skills[skill.id] ?? null %}
                <li>
                    <span{% if not trained %} class="sheet-skill-untrained"{% endif %}>{{ skill.name }}</span>
                    {% if trained %}
                        <span>
                            {{ trained.value }}
                            <form method="post" action="/characters/{{ character.id }}/skills/{{ skill.id }}/toggle-mark" style="display:inline;">
                                <label><input type="checkbox" onchange="this.form.submit()"{% if trained.has_advancement_mark %} checked{% endif %}> Mark</label>
                            </form>
                        </span>
                    {% else %}
                        <span>{{ untrained_base_chance[skill.id] }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>

    {% if heroic_abilities|length > 0 %}
        <div class="sheet-section">
            <h2>Heroic Abilities</h2>
            <ul>
                {% for ability in heroic_abilities %}
                    <li><strong>{{ ability.name }}</strong>{% if ability.wp_cost %} (WP {{ ability.wp_cost }}){% endif %}: {{ ability.description }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if spells|length > 0 %}
        <div class="sheet-section">
            <h2>Zauber</h2>
            <ul>
                {% for spell in spells %}
                    <li><strong>{{ spell.name }}</strong> ({{ spell.rank == 0 ? 'Trick' : 'Rank ' ~ spell.rank }}){% if spell.wp_cost %} — WP {{ spell.wp_cost }}{% endif %}: {{ spell.description }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="sheet-section">
        <h2>Inventar</h2>
        <ul class="sheet-inventory">
            {% for entry in inventory %}
                <li>
                    <span>{{ entry.item_name }} × {{ entry.quantity }}{% if entry.equipped %} (angelegt){% endif %}</span>
                    <span>
                        <form method="post" action="/characters/{{ character.id }}/inventory/{{ entry.id }}/toggle-equipped">
                            <button type="submit" class="btn-secondary">{{ entry.equipped ? 'Ablegen' : 'Anlegen' }}</button>
                        </form>
                        <form method="post" action="/characters/{{ character.id }}/inventory/{{ entry.id }}/delete">
                            <button type="submit" class="btn-secondary">Entfernen</button>
                        </form>
                    </span>
                </li>
            {% else %}
                <li class="entry-empty">Kein Inventar.</li>
            {% endfor %}
        </ul>

        <form method="post" action="/characters/{{ character.id }}/inventory" class="sheet-add-item">
            <select name="item_id">
                {% for item in items %}
                    <option value="{{ item.id }}">{{ item.name }}</option>
                {% endfor %}
            </select>
            <input type="number" name="quantity" min="1" value="1" style="width:5rem;">
            <button type="submit" class="btn-secondary">Hinzufügen</button>
        </form>
    </div>

    <div class="sheet-section">
        <h2>Sonstiges</h2>
        <p><strong>Weakness:</strong> {{ character.weakness ?: '—' }}</p>
        <p><strong>Memento:</strong> {{ character.memento ?: '—' }}</p>
        <p><strong>Sprachen:</strong> {{ character.languages ?: '—' }}</p>
        <p><strong>Appearance:</strong> {{ character.appearance ?: '—' }}</p>
        <p><strong>Münzen:</strong> {{ character.coins_gold }} Gold, {{ character.coins_silver }} Silber, {{ character.coins_copper }} Kupfer</p>
    </div>
{% endblock %}
