{# Header of a campaign page: name and the switch between the two modes. #}
{% macro header(campaign, active) %}
    {% import "_ui.twig" as ui %}
    <div class="dm-page-title">
        <div>
            <a class="ui-muted" href="/dm">{{ ui.icon('arrow-left') }} Kampagnen</a>
            <h1>{{ campaign.name_de }}</h1>
        </div>
        <div class="segmented mode-switch" role="group" aria-label="Modus">
            <a class="segmented__option" href="/dm/campaign/{{ campaign.id }}"{% if active == 'plan' %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ ui.icon('pencil') }} Planen</a>
            <a class="segmented__option" href="/dm/campaign/{{ campaign.id }}/play"{% if active == 'play' %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ ui.icon('dices') }} Spielen</a>
        </div>
    </div>
{% endmacro %}
