{% extends "layout_dm.twig" %}
{% import "_ui.twig" as ui %}
{% import "campaign/_mode.twig" as mode %}
{% import "campaign/_cards.twig" as cards %}

{% block title %}{{ campaign.name_de }} spielen{% endblock %}
{% block main_class %} dm-main--fill{% endblock %}

{% macro place_article(place, full, entityRegistry) %}
    <article class="place-read" id="location-{{ place.id }}">
        <h3>{% if full.number_label %}<span class="place-read__num">#{{ full.number_label }}</span>{% endif %}{{ full.name_de }}</h3>
        {% if full.image_path %}<img class="place-image" src="/{{ full.image_path }}" alt="{{ full.name_de }}" onerror="this.remove()">{% endif %}
        {% if full.description_de %}<p class="read-aloud pre-wrap">{{ full.description_de|linkify(entityRegistry) }}</p>{% endif %}
        {% if full.dm_text_de %}<p class="dm-text pre-wrap">{{ full.dm_text_de|linkify(entityRegistry) }}</p>{% endif %}
        {% if not full.description_de and not full.dm_text_de and not full.image_path %}<p class="ui-muted">Noch kein Text zu diesem Ort.</p>{% endif %}
    </article>
{% endmacro %}
{% import _self as m %}

{% block content %}
    {% set base = '/dm/campaign/' ~ campaign.id %}
    {% set actions %}
        <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-ui-open="#chronicle">{{ ui.icon('notebook-pen') }} Chronik</button>
        <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-ui-open="#foes">{{ ui.icon('skull') }} Gegner{% if foes %} ({{ foes|length }}){% endif %}</button>
        <details class="menu">
            <summary class="ui-btn ui-btn--ghost ui-btn--small">{{ ui.icon('wand-sparkles') }} Werkzeuge {{ ui.icon('chevron-down') }}</summary>
            <div class="menu__list" role="menu">
                {% for group, tables in tableGroups %}
                    <span class="menu__label">{{ group }}</span>
                    {% for table in tables %}<button type="button" role="menuitem" data-ui-open="#table-{{ table.code }}">{{ table.title_de }}</button>{% endfor %}
                {% endfor %}
                {% if encounterTables %}
                    <span class="menu__label">Zufallsbegegnungen</span>
                    {% for table in encounterTables %}<button type="button" role="menuitem" data-ui-open="#encounter-{{ table.id }}">{{ table.name_de }}</button>{% endfor %}
                {% endif %}
                <span class="menu__label">Vorschlag</span>
                <button type="button" role="menuitem" data-ui-open="#npc-suggestion">NSC-Vorschlag</button>
            </div>
        </details>
    {% endset %}

    <div class="play-shell" data-campaign-id="{{ campaign.id }}">
        {{ mode.header(campaign, 'play', actions) }}

        {# ---------- Chapters ---------- #}
        <nav class="chapter-tabs" aria-label="Kapitel">
            {% for c in chapters %}
                <a class="chapter-tab" href="{{ base }}/play/chapter/{{ c.id }}"{% if chapter and chapter.id == c.id %} aria-current="page"{% endif %}>
                    Kapitel {{ c.label }}: {{ c.title_de }}{% if campaign.current_chapter_id == c.id %} <span class="ui-badge ui-badge--gold">aktuell</span>{% endif %}
                </a>
            {% endfor %}
        </nav>

        <div class="play-work">

            {# ---------- Index ---------- #}
            <aside class="play-col play-col--index" aria-label="Index">
                <div class="ui-search">
                    {{ ui.icon('search') }}
                    <input class="ui-input" type="search" id="quick-search" placeholder="Index durchsuchen …" autocomplete="off" aria-label="Index durchsuchen">
                </div>

                {% for group in [
                    {'title': 'Orte', 'type': 'place', 'rows': placeTree},
                    {'title': 'NSC', 'type': 'npc', 'rows': npcs},
                    {'title': 'Monster', 'type': 'bestiary', 'rows': monsters},
                    {'title': 'Items', 'type': 'item', 'rows': items}
                ] %}
                    {% if group.rows is not empty %}
                        <div class="quick__group" data-quick-group>
                            <h2 class="quick__title">{{ group.title }} <span class="ui-muted">{{ group.rows|length }}</span></h2>
                            <ul class="plain-list">
                                {% for row in group.rows %}
                                    <li class="index-row" data-quick-item="{{ row.name_de|lower }}">
                                        {% if group.type == 'place' %}
                                            <a class="entity-link index-link" href="#location-{{ row.id }}" data-entity-type="place" data-entity-id="{{ row.id }}" style="--depth: {{ row.depth }}">
                                                {% if row.number_label %}<span class="outline__num">#{{ row.number_label }}</span>{% endif %}{{ row.name_de }}
                                            </a>
                                        {% else %}
                                            <a class="entity-link index-link" href="#" data-entity-type="{{ group.type }}" data-entity-id="{{ row.id }}">{{ row.name_de }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                {% endfor %}
                <p class="ui-muted" data-quick-empty hidden>Nichts gefunden.</p>
            </aside>

            {# ---------- Reading ---------- #}
            <main class="play-col play-col--read" id="read">
                {% if chapter %}
                    <header class="ui-stack">
                        <h2 class="ui-card__title">{{ ui.icon('scroll-text') }} Kapitel {{ chapter.label }}: {{ chapter.title_de }}</h2>
                        {% if chapter.notes_de %}<p class="pre-wrap">{{ chapter.notes_de|linkify(entityRegistry) }}</p>{% endif %}
                    </header>
                    {% if campaign.background_de and chapter.id == chapters|first.id %}
                        <details class="ui-details">
                            <summary><span class="ui-details__title">Hintergrund der Kampagne</span></summary>
                            <div class="ui-details__body"><p class="pre-wrap">{{ campaign.background_de|linkify(entityRegistry) }}</p></div>
                        </details>
                    {% endif %}
                {% endif %}

                {% if placeTree %}
                    <h2 class="ui-card__title">{{ ui.icon('map') }} Orte</h2>
                    {% for place in placeTree %}
                        {{ m.place_article(place, places|filter(x => x.id == place.id)|first, entityRegistry) }}
                    {% endfor %}
                {% endif %}

                {% if not chapters %}
                    <div class="ui-empty">{{ ui.icon('scroll-text') }}<strong>Noch keine Kapitel</strong><span>Lege sie im Planen-Modus an.</span><a class="ui-btn ui-btn--gold ui-btn--small" href="{{ base }}?e=chapter-new">Kapitel anlegen</a></div>
                {% endif %}

                {% if chapter %}
                    {% set index = chapters|keys|filter(k => chapters[k].id == chapter.id)|first %}
                    <nav class="chapter-pager" aria-label="Kapitel wechseln">
                        {% if index > 0 %}<a class="ui-btn ui-btn--ghost" href="{{ base }}/play/chapter/{{ chapters[index - 1].id }}">{{ ui.icon('arrow-left') }} Kapitel {{ chapters[index - 1].label }}</a>{% else %}<span></span>{% endif %}
                        {% if chapters[index + 1] is defined %}<a class="ui-btn ui-btn--ghost" href="{{ base }}/play/chapter/{{ chapters[index + 1].id }}">Kapitel {{ chapters[index + 1].label }} {{ ui.icon('arrow-right') }}</a>{% endif %}
                    </nav>
                {% endif %}
            </main>

            {# ---------- Party ---------- #}
            <aside class="play-col play-col--group" aria-label="Gruppe">
                {% include 'campaign/_party.twig' %}
            </aside>
        </div>

        {% include 'campaign/_foes.twig' %}
        {% include 'campaign/_chronicle.twig' %}
        {% include 'campaign/_tools.twig' %}
    </div>

    {# ---------- Dialog content (cloned into the entity dialog) ---------- #}
    <div hidden>
        {% for npc in npcs %}<template id="tpl-npc-{{ npc.id }}"{% if npc.bestiary_id %} data-bestiary-id="{{ npc.bestiary_id }}"{% endif %}>{{ cards.npc(npc, campaign.id, entityRegistry) }}</template>{% endfor %}
        {% for place in places %}<template id="tpl-place-{{ place.id }}">{{ cards.place(place, entityRegistry) }}</template>{% endfor %}
        {% for item in items %}<template id="tpl-item-{{ item.id }}">{{ cards.item(item, entityRegistry) }}</template>{% endfor %}
        {% for monster in monsters %}<template id="tpl-bestiary-{{ monster.id }}" data-bestiary-id="{{ monster.id }}">{{ cards.creature(monster, entityRegistry) }}</template>{% endfor %}
    </div>

    <dialog class="ui-sheet ui-sheet--wide" id="entity-sheet">
        <button type="button" class="ui-btn ui-btn--ghost ui-btn--icon ui-sheet__close" data-ui-close aria-label="Schließen">{{ ui.icon('x') }}</button>
        <div id="entity-sheet-body"></div>
    </dialog>

    <dialog class="ui-sheet" id="chronicle-sheet">
        <button type="button" class="ui-btn ui-btn--ghost ui-btn--icon ui-sheet__close" data-ui-close aria-label="Schließen">{{ ui.icon('x') }}</button>
        <form class="ui-stack" id="chronicle-edit-form">
            <h2>Eintrag bearbeiten</h2>
            <div class="ui-field"><label for="che-title">Überschrift</label><input class="ui-input" id="che-title" name="title_de" maxlength="100"></div>
            <div class="ui-field"><label for="che-text">Text</label><textarea class="ui-textarea" id="che-text" name="text_de" rows="6" required></textarea></div>
            <div class="ui-row"><button type="submit" class="ui-btn">{{ ui.icon('check') }} Speichern</button><button type="button" class="ui-btn ui-btn--ghost" data-ui-close>Abbrechen</button></div>
        </form>
    </dialog>

    <script type="module" src="{{ asset('js/dm-forms.js') }}"></script>
    <script type="module" src="{{ asset('js/campaign-play.js') }}"></script>
    <script type="module" src="{{ asset('js/party-picker.js') }}"></script>
{% endblock %}
