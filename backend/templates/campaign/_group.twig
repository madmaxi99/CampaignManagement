{# Gruppe tab of the play view: the party of the day and the foes of the current fight. #}
{% import "_ui.twig" as ui %}

<section class="ui-stack">
    <div class="ui-row group-head">
        <h2 class="ui-card__title">{{ ui.icon('users') }} Spieler</h2>
        <button type="button" class="ui-btn ui-btn--gold ui-btn--small" data-open-picker>{{ ui.icon('plus') }} Charakter hinzufügen</button>
        <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-post data-url="/dm/party/session-end" data-after="toast" title="Alle Mementos sind wieder benutzbar">{{ ui.icon('flame') }} Sitzung beendet</button>
        {% if members %}
            <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-delete data-url="/dm/party" data-confirm="Die ganze Gruppe leeren? Die Charaktere bleiben erhalten." data-after="reload">Gruppe leeren</button>
        {% endif %}
    </div>
    <p class="ui-muted">Deine Merkliste für heute. Werte aktualisieren sich beim Neuladen.</p>

    <div class="party-grid">
        {% for m in members %}
            <article class="ui-card party-card">
                <a class="party-card__head" href="/character/{{ m.id }}">
                    <span class="ui-avatar">{% if m.portrait_path %}<img src="/{{ m.portrait_path }}" alt="" loading="lazy">{% else %}{{ ui.icon('user') }}{% endif %}</span>
                    <span>
                        <strong class="party-card__name">{{ m.name_de }}</strong>
                        <span class="ui-muted">{{ m.kin_de }} · {{ m.profession_de }}</span>
                    </span>
                </a>
                <div class="ui-bar ui-bar--hp" role="meter" aria-label="Trefferpunkte" aria-valuemin="0" aria-valuemax="{{ m.hp_max }}" aria-valuenow="{{ m.hp_current }}">
                    <div class="ui-bar__fill" style="width: {{ m.hp_max > 0 ? (m.hp_current / m.hp_max * 100)|round : 0 }}%"></div>
                    <span class="ui-bar__label">TP {{ m.hp_current }}/{{ m.hp_max }}</span>
                </div>
                <div class="ui-bar ui-bar--wp" role="meter" aria-label="Willenskraft" aria-valuemin="0" aria-valuemax="{{ m.wp_max }}" aria-valuenow="{{ m.wp_current }}">
                    <div class="ui-bar__fill" style="width: {{ m.wp_max > 0 ? (m.wp_current / m.wp_max * 100)|round : 0 }}%"></div>
                    <span class="ui-bar__label">WP {{ m.wp_current }}/{{ m.wp_max }}</span>
                </div>
                <div class="ui-row">
                    <span class="ui-badge">{{ ui.icon('shield') }} Rüstung {{ m.armor_total }}</span>
                    <span class="ui-badge ui-badge--gold">{{ ui.icon('coins') }} {{ m.coins_gold }} G · {{ m.coins_silver }} S · {{ m.coins_copper }} K</span>
                </div>
                <div class="ui-row">
                    {% for c in m.conditions %}<span class="ui-badge ui-badge--berry">{{ c }}</span>{% else %}<span class="ui-muted">Keine Zustände</span>{% endfor %}
                </div>
                <div><button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-delete data-url="/dm/party/{{ m.id }}" data-confirm="{{ m.name_de }} aus der Gruppe nehmen?" data-after="reload">{{ ui.icon('x') }} Aus Gruppe nehmen</button></div>
            </article>
        {% else %}
            <div class="ui-empty">
                {{ ui.icon('users') }}
                <strong>Noch niemand in der Gruppe</strong>
                <span>Füge die Charaktere hinzu, die heute am Tisch sitzen.</span>
            </div>
        {% endfor %}
    </div>
</section>

<section class="ui-stack" id="foes">
    <div class="ui-row group-head">
        <h2 class="ui-card__title">{{ ui.icon('skull') }} Gegner</h2>
        <button type="button" class="ui-btn ui-btn--gold ui-btn--small" data-open-foe-picker>{{ ui.icon('plus') }} Gegner hinzufügen</button>
        {% if foes %}
            <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-delete data-url="{{ base }}/foes" data-confirm="Alle Gegner entfernen?" data-after="reload">Kampf beenden</button>
        {% endif %}
    </div>
    <p class="ui-muted">Die Gegner des aktuellen Kampfes. Trefferpunkte trägst du am Tisch nach.</p>

    <div class="party-grid">
        {% for f in foes %}
            <article class="ui-card party-card">
                <div>
                    <strong class="party-card__name">{{ f.name_de }}</strong>
                    <span class="ui-muted">{{ f.category_de ? f.category_de ~ ' · ' : '' }}Größe {{ f.size_de }} · Bewegung {{ f.movement }}</span>
                </div>
                <div class="ui-bar ui-bar--hp" role="meter" aria-label="Trefferpunkte" aria-valuemin="0" aria-valuemax="{{ f.hp }}" aria-valuenow="{{ f.hp_current }}">
                    <div class="ui-bar__fill" style="width: {{ f.hp > 0 ? (f.hp_current / f.hp * 100)|round : 0 }}%"></div>
                    <span class="ui-bar__label">TP {{ f.hp_current }}/{{ f.hp }}</span>
                </div>
                <div class="ui-row">
                    <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-post data-url="{{ base }}/foes/{{ f.foe_id }}" data-body='{"hp_current": {{ f.hp_current - 1 }}}' data-after="reload" aria-label="Ein Trefferpunkt weniger">−1</button>
                    <button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-post data-url="{{ base }}/foes/{{ f.foe_id }}" data-body='{"hp_current": {{ f.hp_current + 1 }}}' data-after="reload" aria-label="Ein Trefferpunkt mehr">+1</button>
                    <span class="ui-badge">{{ ui.icon('shield') }} Rüstung {{ f.armor_de }}</span>
                    {% if f.hp_current == 0 %}<span class="ui-badge ui-badge--berry">Besiegt</span>{% endif %}
                </div>
                {% if f.attacks %}
                    <ul class="plain-list">
                        {% for a in f.attacks %}<li><strong>{{ a.roll_de }} {{ a.title_de }}:</strong> {{ a.effect_de }}</li>{% endfor %}
                    </ul>
                {% endif %}
                {% if f.traits_de %}<p class="ui-muted">{{ f.traits_de }}</p>{% endif %}
                <div><button type="button" class="ui-btn ui-btn--ghost ui-btn--small" data-dm-delete data-url="{{ base }}/foes/{{ f.foe_id }}" data-after="reload">{{ ui.icon('x') }} Entfernen</button></div>
            </article>
        {% else %}
            <div class="ui-empty">
                {{ ui.icon('skull') }}
                <strong>Kein Kampf läuft</strong>
                <span>Füge die Gegner hinzu, gegen die die Gruppe antritt.</span>
            </div>
        {% endfor %}
    </div>
</section>

<dialog class="ui-sheet" id="party-picker" aria-labelledby="party-picker-title">
    <button type="button" class="ui-btn ui-btn--ghost ui-btn--icon ui-sheet__close" data-ui-close aria-label="Schließen">{{ ui.icon('x') }}</button>
    <div class="ui-stack">
        <h2 id="party-picker-title">Charakter hinzufügen</h2>
        <div class="ui-search">
            {{ ui.icon('search') }}
            <input class="ui-input" type="search" id="party-search" placeholder="Name, Volk oder Beruf …" autocomplete="off" aria-label="Charaktere suchen">
        </div>
        <div class="party-candidates">
            {% for c in candidates %}
                <button type="button" class="party-candidate" data-dm-post data-url="/dm/party" data-body='{"character_id": {{ c.id }}}' data-after="reload"
                        data-search="{{ [c.name_de, c.kin_de, c.profession_de]|join(' ')|lower }}">
                    <strong>{{ c.name_de }}</strong> <span class="ui-muted">{{ c.kin_de }} · {{ c.profession_de }}</span>
                </button>
            {% else %}
                <p class="ui-muted">Alle Charaktere sind schon in der Gruppe.</p>
            {% endfor %}
        </div>
        <div><button type="button" class="ui-btn ui-btn--ghost" data-close-picker>Schließen</button></div>
    </div>
</dialog>

<dialog class="ui-sheet" id="foe-picker" aria-labelledby="foe-picker-title">
    <button type="button" class="ui-btn ui-btn--ghost ui-btn--icon ui-sheet__close" data-ui-close aria-label="Schließen">{{ ui.icon('x') }}</button>
    <form class="ui-stack" data-dm-form data-action="{{ base }}/foes" data-after="reload">
        <h2 id="foe-picker-title">Gegner hinzufügen</h2>
        <div class="ui-field">
            <label for="foe-search">Monster suchen</label>
            <div class="ui-search">
                {{ ui.icon('search') }}
                <input class="ui-input" type="search" id="foe-search" placeholder="Tippen, um die Liste zu kürzen …" autocomplete="off" role="combobox" aria-controls="foe-list" aria-expanded="true">
            </div>
            <input type="hidden" name="bestiary_id" id="foe-bestiary" required>
            <div class="party-candidates" id="foe-list" role="listbox" aria-label="Monster">
                {% for o in foeOptions %}
                    <button type="button" class="party-candidate" role="option" aria-selected="false" data-id="{{ o.id }}" data-search="{{ [o.name_de, o.category_de]|join(' ')|lower }}">
                        <strong>{{ o.name_de }}</strong>{% if o.category_de %} <span class="ui-muted">{{ o.category_de }}</span>{% endif %}
                    </button>
                {% endfor %}
                <p class="ui-muted" id="foe-empty" hidden>Kein Monster gefunden.</p>
            </div>
            <p class="ui-muted" id="foe-chosen">Noch kein Monster gewählt.</p>
        </div>
        <div class="ui-field">
            <label for="foe-count">Anzahl</label>
            <input class="ui-input" id="foe-count" name="count" type="number" min="1" max="20" value="1" required>
        </div>
        <div class="ui-row"><button type="submit" class="ui-btn">{{ ui.icon('plus') }} Hinzufügen</button><button type="button" class="ui-btn ui-btn--ghost" data-ui-close>Abbrechen</button></div>
    </form>
</dialog>
