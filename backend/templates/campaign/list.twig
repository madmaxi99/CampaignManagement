{% extends "layout.twig" %}

{% block title %}Campaigns{% endblock %}

{% macro campaign_card(campaign) %}
    <a class="character-card" href="/campaign/{{ campaign.slug }}">
        <h2>{{ campaign.name_de }}</h2>
        <p class="character-card-meta">{{ campaign.teaser_de }}</p>
    </a>
{% endmacro %}

{% import _self as campaign_macros %}

{% block content %}
<div class="characters-page">
    <h1>Campaigns</h1>

    <section class="character-section">
        <h2>Default</h2>
        <div class="character-grid">
            {% for campaign in defaultCampaigns %}
                {{ campaign_macros.campaign_card(campaign) }}
            {% endfor %}
        </div>
    </section>

    <section class="character-section">
        <h2>Selbsterstellt</h2>
        <div class="character-grid">
            {% for campaign in customCampaigns %}
                {{ campaign_macros.campaign_card(campaign) }}
            {% else %}
                <p class="character-section-empty">Noch keine selbsterstellten Kampagnen.</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
