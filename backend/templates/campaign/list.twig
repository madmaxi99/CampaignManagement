{% extends "layout.twig" %}

{% block title %}Campaigns{% endblock %}

{% macro campaign_card(campaign) %}
    <a class="character-card" href="/campaign/{{ campaign.slug }}">
        <h2>{{ campaign.name_de }}</h2>
        <p class="character-card-meta">{{ campaign.teaser_de }}</p>
    </a>
{% endmacro %}

{% import _self as campaign_macros %}
{% import "_entity_grid_page.twig" as grid_page %}

{% block content %}
    {{ grid_page.render(
        'Campaigns',
        defaultCampaigns|map(c => campaign_macros.campaign_card(c)),
        customCampaigns|map(c => campaign_macros.campaign_card(c)),
        'Noch keine selbsterstellten Kampagnen.'
    ) }}
{% endblock %}
