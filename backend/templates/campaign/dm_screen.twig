{% extends "layout.twig" %}

{% block title %}{{ campaign.name_de }}{% endblock %}

{% macro location_block(location, entityRegistry, campaignId) %}
    <div class="location-block" id="location-{{ location.id }}">
        <h4>#{{ location.number_label }} — {{ location.name_de }}</h4>
        <img class="location-map" src="{{ location.image_path ? '/' ~ location.image_path : '/images/campaigns/' ~ campaignId ~ '/floor-' ~ location.number_label ~ '.jpg' }}" alt="Kartenausschnitt {{ location.name_de }}" onerror="this.remove()">
        {% if location.description_de %}
            <p class="location-read-aloud">{{ location.description_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if location.dm_text_de %}
            <p class="location-notes pre-wrap">{{ location.dm_text_de|linkify(entityRegistry) }}</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro creature_block(creature, entityRegistry) %}
    <div class="creature-card">
        <img class="creature-portrait" src="/images/creatures/{{ creature.id }}.jpg" alt="{{ creature.name_de }}" onerror="this.remove()">
        <h3>{{ creature.name_de }}</h3>
        <div class="derived-stats creature-stats">
            <div><span class="label">TP</span><span class="value">{{ creature.hp }}</span></div>
            <div><span class="label">Grimmigkeit</span><span class="value">{{ creature.grimmigkeit_de }}</span></div>
            <div><span class="label">Größe</span><span class="value">{{ creature.size_de }}</span></div>
            <div><span class="label">Bewegung</span><span class="value">{{ creature.movement }}</span></div>
            <div><span class="label">Rüstung</span><span class="value">{{ creature.armor_de }}</span></div>
        </div>
        {% if creature.resistances_de %}
            <p class="pre-wrap"><strong>Resistenzen:</strong> {{ creature.resistances_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if creature.immunities_de %}
            <p class="pre-wrap"><strong>Immunität:</strong> {{ creature.immunities_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if creature.traits_de %}
            <p class="pre-wrap"><strong>Besonderheiten:</strong> {{ creature.traits_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if creature.kit_de %}
            <p class="pre-wrap"><strong>Profil:</strong> {{ creature.kit_de }}</p>
        {% endif %}
        {% if creature.campaign_notes_de %}
            <p class="pre-wrap"><strong>In dieser Kampagne:</strong> {{ creature.campaign_notes_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if creature.attacks is not empty %}
            <table class="weapon-table">
                <thead>
                    <tr><th>Wurf</th><th>Angriff</th><th>Effekt</th></tr>
                </thead>
                <tbody>
                    {% for attack in creature.attacks %}
                        <tr>
                            <td>{{ attack.roll_de }}</td>
                            <td>{{ attack.title_de }}</td>
                            <td class="pre-wrap">{{ attack.effect_de|linkify(entityRegistry) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endmacro %}

{% macro npc_block(npc, entityRegistry) %}
    {% import _self as blocks %}
    <div class="npc-card">
        {% if npc.portrait_path %}
            <img class="creature-portrait" src="/{{ npc.portrait_path }}" alt="{{ npc.name_de }}" onerror="this.remove()">
        {% endif %}
        <div class="card-heading-row">
            <h3>{{ npc.name_de }}</h3>
            <div class="npc-card-actions">
                <button type="button" class="advance-button" data-npc-edit="{{ npc.id }}">Bearbeiten</button>
            </div>
        </div>
        {% if npc.description_de %}
            <p class="location-read-aloud pre-wrap">{{ npc.description_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if npc.dm_text_de %}
            <p class="pre-wrap"><strong>Für den DM:</strong> {{ npc.dm_text_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if npc.found_hint_de or npc.place_de %}
            <p class="pre-wrap"><strong>Zu finden:</strong> {{ [npc.place_de, npc.found_hint_de]|filter(v => v)|join(' – ') }}</p>
        {% endif %}
        {% if npc.notes_de %}
            <p class="pre-wrap"><strong>Notizen:</strong> {{ npc.notes_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if npc.creature %}
            {{ blocks.creature_block(npc.creature, entityRegistry) }}
        {% endif %}
    </div>
{% endmacro %}

{% macro place_block(place, entityRegistry) %}
    <div class="npc-card">
        {% if place.image_path %}
            <img class="creature-portrait" src="/{{ place.image_path }}" alt="{{ place.name_de }}" onerror="this.remove()">
        {% endif %}
        <div class="card-heading-row">
            <h3>{{ place.name_de }}{% if place.parent_de %} <small>(in {{ place.parent_de }})</small>{% endif %}</h3>
            <div class="npc-card-actions">
                <button type="button" class="advance-button" data-place-edit="{{ place.id }}">Bearbeiten</button>
            </div>
        </div>
        {% if place.description_de %}
            <p class="location-read-aloud pre-wrap">{{ place.description_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if place.dm_text_de %}
            <p class="pre-wrap"><strong>Für den DM:</strong> {{ place.dm_text_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if place.encounter_table_de %}
            <p><strong>Zufallsbegegnungen:</strong> {{ place.encounter_table_de }}</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro item_block(item, entityRegistry) %}
    <div class="npc-card">
        {% if item.image_path %}
            <img class="creature-portrait" src="/{{ item.image_path }}" alt="{{ item.name_de }}" onerror="this.remove()">
        {% endif %}
        <h3>{{ item.name_de }}</h3>
        {% if item.description_de %}
            <p class="location-read-aloud pre-wrap">{{ item.description_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if item.dm_text_de %}
            <p class="pre-wrap"><strong>Für den DM:</strong> {{ item.dm_text_de|linkify(entityRegistry) }}</p>
        {% endif %}
        {% if item.found_hint_de or item.place_de %}
            <p class="pre-wrap"><strong>Zu finden:</strong> {{ [item.place_de, item.found_hint_de]|filter(v => v)|join(' – ') }}</p>
        {% endif %}
        {% if item.text_de %}
            <p class="pre-wrap"><strong>Text:</strong> {{ item.text_de }}</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro event_table_block(table, entityRegistry) %}
    <div class="event-table">
        <div class="card-heading-row">
            <h3>{{ table.name_de }}</h3>
            <div class="event-roll-controls">
                <span class="event-roll-result" data-roll-result></span>
                <button type="button" class="advance-button" data-roll-button>Würfeln</button>
            </div>
        </div>
        <ul class="event-table-list">
            {% for entry in table.entries %}
                <li class="event-entry"
                    data-min="{{ entry.min_roll }}"
                    data-max="{{ entry.max_roll ?? entry.min_roll }}"
                    data-open-ended="{{ entry.max_roll is null ? '1' : '0' }}">
                    <span class="event-roll">{{ entry.max_roll is null ? entry.min_roll ~ '+' : (entry.min_roll == entry.max_roll ? entry.min_roll : entry.min_roll ~ '–' ~ entry.max_roll) }}</span>
                    <span class="event-text">{{ entry.text_de|linkify(entityRegistry) }}</span>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endmacro %}

{% import _self as campaign_macros %}

{% block content %}
<div class="campaign-dm-screen" data-campaign-id="{{ campaign.id }}">

    <header class="sheet-header">
        <h1>{{ campaign.name_de }}</h1>
        <p class="appearance">{{ campaign.teaser_de }}</p>
    </header>

    <div class="campaign-layout">
        <nav class="campaign-sidebar">
            <a class="sidebar-link" href="#hintergrund">Hintergrund</a>

            {% for chapter in chapters %}
                <div class="sidebar-group">
                    <span class="sidebar-group-title">Kapitel {{ chapter.label }}: {{ chapter.title_de }}</span>
                    <ul>
                        {% for location in locations %}
                            {% if location.chapter_id == chapter.id %}
                                <li><a class="location-ref" href="#location-{{ location.id }}">#{{ location.number_label }} — {{ location.name_de }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}

            <div class="sidebar-group">
                <span class="sidebar-group-title">Bestiary</span>
                <ul>
                    {% for creature in bestiary %}
                        <li><a class="entity-link" href="#" data-entity-type="bestiary" data-entity-id="{{ creature.id }}">{{ creature.name_de }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div class="sidebar-group">
                <span class="sidebar-group-title">NPCs</span>
                <button type="button" class="advance-button npc-add-button" data-npc-add>+ NPC</button>
                <ul>
                    {% for npc in npcs %}
                        <li><a class="entity-link" href="#" data-entity-type="npc" data-entity-id="{{ npc.id }}">{{ npc.name_de }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div class="sidebar-group">
                <span class="sidebar-group-title">Orte</span>
                <button type="button" class="advance-button npc-add-button" data-place-add>+ Ort</button>
                <ul>
                    {% for place in places %}
                        {% if place.number_label is null %}
                            <li><a class="entity-link" href="#" data-entity-type="place" data-entity-id="{{ place.id }}">{{ place.name_de }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>

            {% if items is not empty %}
                <div class="sidebar-group">
                    <span class="sidebar-group-title">Items</span>
                    <ul>
                        {% for item in items %}
                            <li><a class="entity-link" href="#" data-entity-type="item" data-entity-id="{{ item.id }}">{{ item.name_de }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if encounterTables is not empty %}
                <div class="sidebar-group">
                    <span class="sidebar-group-title">Zufallsbegegnungen</span>
                    <ul>
                        {% for table in encounterTables %}
                            <li><a class="entity-link" href="#" data-entity-type="event-table" data-entity-id="{{ table.id }}">{{ table.name_de }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <a class="sidebar-link" href="#chronik">Chronik</a>
        </nav>

        <div class="campaign-content">
            <section class="card" id="hintergrund">
                <h2>Hintergrund</h2>
                <p class="campaign-background pre-wrap">{{ campaign.background_de|linkify(entityRegistry) }}</p>
            </section>

            {% for chapter in chapters %}
                <section class="card">
                    <h2>Kapitel {{ chapter.label }}: {{ chapter.title_de }}</h2>
                    {% if loop.first %}
                        <img class="campaign-map" src="/images/campaigns/{{ campaign.id }}/map.jpg" alt="Kartenplan {{ campaign.name_de }}" onerror="this.remove()">
                    {% endif %}
                    {% if chapter.notes_de %}
                        <p class="pre-wrap">{{ chapter.notes_de|linkify(entityRegistry) }}</p>
                    {% endif %}
                    <div class="location-list">
                        {% for location in locations %}
                            {% if location.chapter_id == chapter.id %}
                                {{ campaign_macros.location_block(location, entityRegistry, campaign.id) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}

            <section class="card" id="chronik">
                <div class="card-heading-row">
                    <h2>Chronik</h2>
                    <button type="button" class="advance-button" data-campaign-restart>Kampagne neu starten</button>
                </div>
                <form class="stand-form" data-chronicle-form>
                    <input type="text" name="title_de" maxlength="100" placeholder="Überschrift, z. B. Session 4 (optional)">
                    <textarea name="text_de" rows="3" placeholder="Was ist passiert?" required></textarea>
                    <button type="submit" class="advance-button">Eintragen</button>
                </form>
                <ul class="event-log">
                    {% for entry in chronicle %}
                        <li class="event-log-entry" data-chronicle-entry="{{ entry.id }}">
                            <div class="stand-entry-text">
                                <strong>{{ entry.title_de ?? entry.created_at|date('d.m.Y') }}</strong>
                                <p class="pre-wrap" data-entry-text>{{ entry.text_de }}</p>
                                <span hidden data-entry-raw-title>{{ entry.title_de }}</span>
                            </div>
                            <div class="event-log-state">
                                <button type="button" class="advance-button" data-chronicle-edit="{{ entry.id }}">Bearbeiten</button>
                                <button type="button" class="advance-button" data-chronicle-delete="{{ entry.id }}">Löschen</button>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>

        </div>
    </div>

    <div class="entity-templates" hidden>
        {% for creature in bestiary %}
            <template id="tpl-bestiary-{{ creature.id }}">
                {{ campaign_macros.creature_block(creature, entityRegistry) }}
            </template>
        {% endfor %}
        {% for npc in npcs %}
            <template id="tpl-npc-{{ npc.id }}">
                {{ campaign_macros.npc_block(npc, entityRegistry) }}
            </template>
        {% endfor %}
        {% for place in places %}
            <template id="tpl-place-{{ place.id }}">
                {{ campaign_macros.place_block(place, entityRegistry) }}
            </template>
        {% endfor %}
        {% for item in items %}
            <template id="tpl-item-{{ item.id }}">
                {{ campaign_macros.item_block(item, entityRegistry) }}
            </template>
        {% endfor %}
        {% for table in encounterTables %}
            <template id="tpl-event-table-{{ table.id }}">
                {{ campaign_macros.event_table_block(table, entityRegistry) }}
            </template>
        {% endfor %}
    </div>

    <dialog id="npc-form-modal" class="entity-modal">
        <button type="button" class="entity-modal-close" data-npc-form-close aria-label="Schließen">×</button>
        <form id="npc-form" class="npc-form">
            <h2 data-npc-form-title>Neuer NPC</h2>
            <p class="npc-form-error" data-npc-form-error hidden></p>
            <label>Name <input type="text" name="name_de" maxlength="150" required></label>
            <label>Beschreibung (kann vorgelesen werden) <textarea name="description_de" rows="3"></textarea></label>
            <label>Für den DM (Theater, Geheimnisse) <textarea name="dm_text_de" rows="3"></textarea></label>
            <label>Notizen in dieser Kampagne <textarea name="notes_de" rows="2" placeholder="lebt, mochte Aodhan, geflohen …"></textarea></label>
            <label>Zu finden (Quest-NPC) <input type="text" name="found_hint_de" maxlength="255" placeholder="bei den Hundekämpfen"></label>
            <label>Kampfvorlage
                <select name="bestiary_id">
                    <option value="">– keine –</option>
                    {% for template in npcFormData.bestiary %}<option value="{{ template.id }}">{{ template.name_de }}{% if template.category_de %} ({{ template.category_de }}){% endif %}</option>{% endfor %}
                </select>
            </label>
            <label>Portrait <input type="file" name="portrait" accept="image/jpeg,image/png,image/webp"></label>
            <div class="npc-form-actions">
                <span></span>
                <button type="submit" class="advance-button">Speichern</button>
            </div>
        </form>
    </dialog>

    <dialog id="place-form-modal" class="entity-modal">
        <button type="button" class="entity-modal-close" data-place-form-close aria-label="Schließen">×</button>
        <form id="place-form" class="npc-form">
            <h2 data-place-form-title>Neuer Ort</h2>
            <p class="npc-form-error" data-place-form-error hidden></p>
            <label>Name <input type="text" name="name_de" maxlength="150" required></label>
            <label>Liegt in
                <select name="parent_id">
                    <option value="">– oberste Ebene –</option>
                    {% for place in places %}<option value="{{ place.id }}">{{ place.name_de }}</option>{% endfor %}
                </select>
            </label>
            <label>Beschreibung (kann vorgelesen werden) <textarea name="description_de" rows="3"></textarea></label>
            <label>Für den DM <textarea name="dm_text_de" rows="3"></textarea></label>
            <label>Zufallsbegegnungen
                <select name="encounter_table_id">
                    <option value="">– keine –</option>
                    {% for table in encounterTableOptions %}<option value="{{ table.id }}">{{ table.name_de }}</option>{% endfor %}
                </select>
            </label>
            <label>Bild <input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label>
            <div class="npc-form-actions">
                <span></span>
                <button type="submit" class="advance-button">Speichern</button>
            </div>
        </form>
    </dialog>

    <script type="application/json" id="place-form-data">{{ placeFormData|json_encode|raw }}</script>

    <script type="application/json" id="npc-form-data">{{ npcFormData.npcs|json_encode|raw }}</script>

    <dialog id="entity-modal" class="entity-modal">
        <button type="button" class="entity-modal-close" data-modal-close aria-label="Schließen">×</button>
        <div class="entity-modal-body" data-modal-body></div>
    </dialog>

</div>

<script src="/js/campaign-dm-screen.js"></script>
<script src="/js/campaign-npc-editor.js"></script>
<script src="/js/campaign-place-editor.js"></script>
<script src="/js/campaign-chronicle.js"></script>
{% endblock %}
