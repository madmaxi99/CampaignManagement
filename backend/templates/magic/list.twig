{% extends 'layout.twig' %}
{% block title %}Magie — Regelwerk{% endblock %}
{% block content %}
    <h1>Magie</h1>

    {% for school in schools %}
        <h2>{{ school.name }}</h2>
        {% if school.description %}<p class="char-hint">{{ school.description }}</p>{% endif %}
        <table class="ref-table">
            <thead>
                <tr><th>Rank</th><th>Name</th><th>WP</th><th>Beschreibung</th></tr>
            </thead>
            <tbody>
                {% for spell in spells_by_school[school.id] ?? [] %}
                    <tr>
                        <td>{{ spell.rank == 0 ? 'Trick' : spell.rank }}</td>
                        <td>{{ spell.name }}</td>
                        <td>{{ spell.wp_cost ?? '—' }}</td>
                        <td>{{ spell.description }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="entry-empty">Keine Zauber hinterlegt.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    {% endfor %}

    {% if unschooled_spells|length > 0 %}
        <h2>Ohne Schule</h2>
        <table class="ref-table">
            <thead>
                <tr><th>Rank</th><th>Name</th><th>WP</th><th>Beschreibung</th></tr>
            </thead>
            <tbody>
                {% for spell in unschooled_spells %}
                    <tr>
                        <td>{{ spell.rank == 0 ? 'Trick' : spell.rank }}</td>
                        <td>{{ spell.name }}</td>
                        <td>{{ spell.wp_cost ?? '—' }}</td>
                        <td>{{ spell.description }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
